    "ps_testimonials_VRiX76": {
      "type": "ps-testimonials",
      "blocks": {
        "testimonial_01": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "I was planning my first trip to Korea and felt overwhelmed by all the information online. This guide kit made everything feel more organized and less stressful.",
            "name": "Emily R. (USA)"
          }
        },
        "testimonial_02": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "With my work schedule, I didn’t have hours to dig through travel blogs. This guide kit saved me a ton of time and gave me a clear starting point for my first Korea trip.",
            "name": "Daniel M. (USA)"
          }
        },
        "testimonial_03": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "I was planning my first solo trip to Korea and didn’t want to overplan every day. Purple Map made it easy to group spots by area and keep my route flexible.",
            "name": "Jake T. (USA)"
          }
        },
        "testimonial_04": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "We were in Korea for our honeymoon and used Purple Map a lot to find food nearby. The directions were super helpful and made getting around feel easy.",
            "name": "Sophie W. (UK)"
          }
        },
        "testimonial_05": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "Honestly, I’m pretty picky when traveling with my family, but this tour felt really well handled. It was just our family, the guide and the driver, so the day felt safe and personal.",
            "name": "Anna K. (Germany)"
          }
        },
        "testimonial_06": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "My first Korea trip was just a quick Seoul stop, but I knew I’d be back. The Korea Guide Kit made Busan and Gyeongju with my friend way easier.",
            "name": "Ryan C. (Canada)"
          }
        },
        "testimonial_07": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "My friend and I came to Korea mainly for the food and Purple Map led us to local restaurants we never would’ve found alone. That meal honestly made the trip feel real.",
            "name": "Mia L. (Australia)"
          }
        },
        "testimonial_08": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "I thought I knew what to eat in Korea, but the Korea Guide Kit put grilled eel on my list. My partner and I tried it and it felt like Korea’s hidden BBQ. So good.",
            "name": "Jason M. (USA)"
          }
        },
        "testimonial_09": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "The Korea Guide Kit showed us a night view spot I never saw in regular travel posts. We used Purple Map to get there, and honestly it became one of the best moments of our trip.",
            "name": "Rachel B. (USA)"
          }
        },
        "testimonial_10": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "I downloaded the apps from the Guide Kit before I flew out. My first day in Korea felt way less stressful, and I could just wander instead of figuring everything out.",
            "name": "Liam T. (New Zealand)"
          }
        },
        "testimonial_11": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "We booked this tour for our first day in Korea, and honestly it was perfect. Airport pickup, hotel drop-off, and a guide who was kind without hovering. Best start to our honeymoon.",
            "name": "Claire M. (Canada)"
          }
        },
        "testimonial_12": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "I spent a month in Korea solo and wanted more than Seoul. The Korea Guide Kit made transport less scary, and driving the Jeju coast was the best part.",
            "name": "Emma R. (USA)"
          }
        },
        "testimonial_13": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "The moment our guide mixed somaek at BBQ, our whole table lost it. It was loud, funny, and somehow one of the most Korean moments of our trip.",
            "name": "Tyler J. (USA)"
          }
        },
        "testimonial_14": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "The amount of food in the Korean set meal honestly shocked my mum, dad and me. Our guide explained the dishes and little stories behind them, which made dinner way more fun.",
            "name": "Olivia H. (UK)"
          }
        },
        "testimonial_15": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "I’m the planner in my friend group, so the Korea Guide Kit was perfect for me. The server smiled and said we wrapped ssam right, and for a second we felt less like tourists.",
            "name": "Nathan B. (USA)"
          }
        },
        "testimonial_16": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "Midway through our Korea trip, my boyfriend and I needed a slow day. The Korean spa was perfect, and our guide made us sheep-head towels for photos. So cute.",
            "name": "Madison L. (USA)"
          }
        },
        "testimonial_17": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "So glad we booked this on day one. Our guide checked our plans, looked things up for us, and made us feel like a local had our back.",
            "name": "Luke M. (Australia)"
          }
        }
      },
