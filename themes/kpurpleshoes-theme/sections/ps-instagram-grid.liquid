{%- liquid
  assign cta_label = 'Get My Free Guide'
  if customer
    assign cta_label = 'Explore Now'
  endif
-%}

<section class="ps-ig" id="ps-ig-{{ section.id }}">
  <div class="ps-container">
    <div class="ps-ig__title">{{ section.settings.heading | escape }}</div>
    <div class="ps-ig__rule"></div>

    <div class="ps-ig__carousel">
      <button type="button" class="ps-ig__arrow ps-ig__arrow--prev" aria-label="Previous" data-ps-ig-prev>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button type="button" class="ps-ig__arrow ps-ig__arrow--next" aria-label="Next" data-ps-ig-next>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      <div class="ps-ig__scroll" aria-label="Instagram" role="region" tabindex="0">
        <div class="ps-ig__track">
          {% for block in section.blocks %}
            {% if block.settings.image != blank %}
              <div class="ps-ig__item" {{ block.shopify_attributes }}>
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,350,500', sizes: '234px' }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    {% if section.settings.button_link != blank %}
      <div class="ps-ig__cta">
        <a class="ps-btn ps-btn--ig" href="{{ section.settings.button_link }}" target="_blank" rel="noopener">
          {{ cta_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<script>
(function() {
  const section = document.getElementById('ps-ig-{{ section.id }}');
  if (!section) return;
  const scrollEl = section.querySelector('.ps-ig__scroll');
  const trackEl = section.querySelector('.ps-ig__track');
  const prevBtn = section.querySelector('[data-ps-ig-prev]');
  const nextBtn = section.querySelector('[data-ps-ig-next]');
  if (!scrollEl || !trackEl || !prevBtn || !nextBtn) return;
  const images = Array.from(trackEl.children);
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let cycleWidth = 0;
  let position = scrollEl.scrollLeft;
  let lastTime = 0;
  let frame = 0;
  let hovered = false;
  let touching = false;
  scrollEl.style.scrollBehavior = 'auto';
  images.forEach(function(image) {
    const copy = image.cloneNode(true);
    copy.removeAttribute('data-shopify-editor-block');
    copy.setAttribute('aria-hidden', 'true');
    copy.inert = true;
    trackEl.appendChild(copy);
  });

  function getScrollAmount() {
    const first = trackEl.querySelector('.ps-ig__item');
    if (!first) return scrollEl.clientWidth * 0.8;
    return first.offsetWidth + parseInt(getComputedStyle(trackEl).gap) || 14;
  }

  function updateArrows() {
    const first = images[0];
    const last = images[images.length - 1];
    cycleWidth = first ? last.offsetLeft - first.offsetLeft + last.offsetWidth +
      (parseFloat(getComputedStyle(trackEl).gap) || 0) : 0;
    const needsScroll = cycleWidth > scrollEl.clientWidth;
    images.forEach(function(image, index) {
      trackEl.children[images.length + index].hidden = !needsScroll;
    });
    prevBtn.style.visibility = needsScroll ? 'visible' : 'hidden';
    nextBtn.style.visibility = needsScroll ? 'visible' : 'hidden';
  }

  prevBtn.addEventListener('click', function() {
    if (cycleWidth && scrollEl.scrollLeft < getScrollAmount()) {
      scrollEl.scrollLeft += cycleWidth;
    }
    scrollEl.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
  });
  nextBtn.addEventListener('click', function() {
    scrollEl.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
  });
  section.addEventListener('pointerenter', function(event) {
    if (event.pointerType === 'mouse') hovered = true;
  });
  section.addEventListener('pointerleave', function() { hovered = false; });
  scrollEl.addEventListener('touchstart', function() { touching = true; }, { passive: true });
  scrollEl.addEventListener('touchend', function() { touching = false; }, { passive: true });
  scrollEl.addEventListener('touchcancel', function() { touching = false; }, { passive: true });
  window.addEventListener('resize', updateArrows);
  updateArrows();

  function animate(time) {
    if (!section.isConnected) {
      window.removeEventListener('resize', updateArrows);
      return;
    }
    const paused = reducedMotion.matches || document.hidden || hovered || touching ||
      section.contains(document.activeElement) || cycleWidth <= scrollEl.clientWidth;
    if (paused || !lastTime) {
      position = scrollEl.scrollLeft;
    } else {
      position += cycleWidth * Math.min(time - lastTime, 50) / 50000;
      if (position >= cycleWidth) position %= cycleWidth;
      scrollEl.scrollTo({ left: position, behavior: 'instant' });
    }
    lastTime = time;
    frame = requestAnimationFrame(animate);
  }
  frame = requestAnimationFrame(animate);
  window.addEventListener('pagehide', function() { cancelAnimationFrame(frame); });
  window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
      lastTime = 0;
      frame = requestAnimationFrame(animate);
    }
  });
})();
</script>

{% schema %}
{
  "name": "PS Instagram Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SEE YOU ON INSTAGRAM" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow" },
    { "type": "url", "id": "button_link", "label": "Instagram URL" }
  ],
  "blocks": [
    {
      "type": "instagram_image",
      "name": "Instagram image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "PS Instagram Grid",
      "blocks": [
        { "type": "instagram_image" },
        { "type": "instagram_image" },
        { "type": "instagram_image" }
      ]
    }
  ]
}
{% endschema %}
