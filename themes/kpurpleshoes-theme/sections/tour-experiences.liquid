{% comment %}
  Section: Tour Experiences Grid
  - 3-column cards with image + overlaid texts + title/desc + button
{% endcomment %}

<section class="tg-exp" style="
  --tg-bg: {{ section.settings.bg }};
  --tg-title: {{ section.settings.title_color }};
  --tg-text: {{ section.settings.text_color }};
  --tg-muted: {{ section.settings.muted_color }};
  --tg-btn: {{ section.settings.btn_bg }};
  --tg-btn-text: {{ section.settings.btn_text }};
  --tg-radius: {{ section.settings.radius }}px;
  --tg-gap: {{ section.settings.gap }}px;
  --tg-hero-h: {{ section.settings.hero_height | default: 360 }}px;
  --tg-overlay-top: {{ section.settings.overlay_top | default: 0.8 }};
  --tg-overlay-mid: {{ section.settings.overlay_mid | default: 0.6 }};
  --tg-overlay-bot: {{ section.settings.overlay_bottom | default: 0.3 }};
  --tg-title-size: {{ section.settings.hero_title_size | default: 44 }}px;
  --tg-title-weight: {{ section.settings.hero_title_weight | default: 700 }};
  --tg-title-letter: {{ section.settings.hero_title_letter_spacing | default: 0 }}em;
  --tg-title-transform: {{ section.settings.hero_title_transform | default: 'none' }};
  --tg-title-max: {{ section.settings.hero_title_max_width | default: 22 }}ch;
  --tg-title-align: {{ section.settings.hero_title_align | default: 'center' }};
  --tg-title-pad-y: {{ section.settings.hero_title_pad_y | default: 12 }}px;
  --tg-title-pad-x: {{ section.settings.hero_title_pad_x | default: 20 }}px;
  --tg-title-bg-opacity: {{ section.settings.hero_title_bg_opacity | default: 0.6 }};
  --tg-title-bg-radius: {{ section.settings.hero_title_bg_radius | default: 12 }}px;
  --tg-title-font: {% if section.settings.hero_title_font == 'heading' %}var(--font-heading-family){% elsif section.settings.hero_title_font == 'body' %}var(--font-body-family){% else %}inherit{% endif %};
">
  {% if section.settings.show_hero %}
    <section class="tg-hero" aria-label="Experience hero">
      <div class="tg-hero__media{% if section.settings.hero_image == blank %} tg-hero__media--fallback{% endif %}">
        {% if section.settings.hero_image != blank %}
          <img
            src="{{ section.settings.hero_image | image_url: width: 2400 }}"
            alt="{{ section.settings.hero_image.alt | default: 'Experience hero image' | escape }}"
            loading="lazy"
            width="{{ section.settings.hero_image.width }}"
            height="{{ section.settings.hero_image.height }}"
          >
        {% endif %}

        <div class="tg-hero__overlay" aria-hidden="true"></div>

        <div class="tg-hero__content page-width">
          <h1 class="tg-title">
            {% if section.settings.hero_title_bg_enable %}
              <span class="tg-title__bg" aria-hidden="true"></span>
            {% endif %}
            <span class="tg-title__text">
              {% if section.settings.hero_heading != blank %}
                {{ section.settings.hero_heading | escape | newline_to_br }}
              {% elsif section.settings.hero_use_page_title %}
                {% if page and page.title != blank %}
                  {{ page.title | escape }}
                {% elsif collection and collection.title != blank %}
                  {{ collection.title | escape }}
                {% elsif section.settings.heading != blank %}
                  {{ section.settings.heading | escape }}
                {% else %}
                  Experiences
                {% endif %}
              {% elsif section.settings.heading != blank %}
                {{ section.settings.heading | escape }}
              {% else %}
                Experiences
              {% endif %}
            </span>
          </h1>
        </div>
      </div>
    </section>
  {% endif %}

  <div class="tg-exp__inner page-width">
    <h2 class="tg-exp__section-title">{{ section.settings.heading | default: 'Daily Experiences' }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="tg-exp__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    {% liquid
      assign source_collection = section.settings.collection
      if collection and collection.handle != blank
        assign source_collection = collection
      endif
      assign products_limit = section.settings.products_to_show | default: 2
      assign has_products = false
      if source_collection != blank and source_collection.products_count > 0 and collection.handle != 'experience-tour'
        assign has_products = true
      endif
    %}

    <div class="tg-exp__grid tg-exp__grid--daily" role="list">
      {% if has_products %}
        {% assign has_coming_soon_product = false %}
        {% for product in source_collection.products limit: products_limit %}
          {% liquid
            assign meta = product.metafields.custom
            assign tag = meta.days.value | default: meta.days
            assign title = meta.tg_title.value | default: product.title
            assign raw_desc = meta.tg_desc.value | default: product.description
            assign desc = raw_desc | strip_html | strip | truncate: 140
            assign btn_label = 'Explore Journey'
            assign img = product.featured_image
            assign link = product.url | default: '#'
            assign features_str = meta.tg_features.value | default: ''
            assign gallery_images = meta.travel_gallery.value
            assign gallery_count = 0
            if gallery_images != blank
              assign gallery_count = gallery_images.size
            endif
            assign is_coming_soon = meta.coming_soon.value | default: false
            assign normalized_product_title = product.title | downcase
            if normalized_product_title contains 'korean folk village'
              assign is_coming_soon = true
            endif
            if is_coming_soon
              assign has_coming_soon_product = true
            endif
          %}
          <article class="tg-card tg-card--daily{% if is_coming_soon %} tg-card--coming-soon{% endif %}" role="listitem">
            <div class="tg-card__media-wrap">
              {% if is_coming_soon %}<div class="tg-card__media">{% else %}<a class="tg-card__media" href="{{ link }}" aria-label="{{ product.title | escape }}">{% endif %}
                {% if gallery_count > 1 %}
                  <div class="tg-card__media-slider" data-tg-card-slider>
                    <div class="tg-card__media-track" data-tg-card-track>
                      {% for gallery_image in gallery_images %}
                        <div class="tg-card__media-slide" data-tg-card-slide>
                          {{
                            gallery_image
                            | image_url: width: 1200
                            | image_tag:
                              loading: 'lazy',
                              class: 'tg-card__img',
                              alt: gallery_image.alt | default: product.title
                          }}
                        </div>
                      {% endfor %}
                    </div>
                    <div class="tg-card__media-dots" data-tg-card-dots aria-hidden="true">
                      {% for gallery_image in gallery_images %}
                        <span class="tg-card__media-dot{% if forloop.first %} is-active{% endif %}"></span>
                      {% endfor %}
                    </div>
                  </div>
                {% elsif gallery_count == 1 %}
                  {{
                    gallery_images.first
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'tg-card__img',
                      alt: gallery_images.first.alt | default: product.title
                  }}
                {% elsif img != blank %}
                  {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'tg-card__img', alt: img.alt | default: product.title }}
                {% else %}
                  <div class="tg-card__img tg-card__img--ph" aria-hidden="true"></div>
                {% endif %}
                <div class="tg-card__media-overlay" aria-hidden="true"></div>
                {% if is_coming_soon %}
                  <div class="tg-card__coming-soon-overlay">
                    <span class="tg-card__coming-soon-badge">Preparing</span>
                  </div>
                {% endif %}
                <div class="tg-card__media-content">
                  {% if tag != blank %}
                    <p class="tg-card__meta">{{ tag }}</p>
                  {% endif %}
                  {% if title != blank %}
                    <h3 class="tg-card__title">{{ title }}</h3>
                  {% endif %}
                  {% if meta.list_summary != blank %}
                    <div class="tg-card__media-desc">{{ meta.list_summary | metafield_tag }}</div>
                  {% endif %}
                </div>
              {% if is_coming_soon %}</div>{% else %}</a>{% endif %}
            </div>
            <div class="tg-card__body">
              <h3 class="tg-card__body-title">{{ title | escape }}</h3>
              {% if meta.list_summary != blank %}
                <div class="tg-card__body-description">{{ meta.list_summary | metafield_tag }}</div>
              {% endif %}
              {% if meta.travel_summary != blank %}
                <div class="tg-card__summary rte">{{ meta.travel_summary | metafield_tag }}</div>
              {% endif %}
              {% if features_str != blank %}
                {% assign features_list = features_str | strip | newline_to_br | replace: '<br>', '<br />' | split: '<br />' %}
                <ul class="tg-card__features">
                  {% for f in features_list %}
                    {% assign item = f | strip %}
                    {% if item != blank %}<li>{{ item }}</li>{% endif %}
                  {% endfor %}
                </ul>
              {% endif %}
              {% unless is_coming_soon %}
                <a class="tg-card__btn" href="{{ link }}">{{ btn_label }} <span aria-hidden="true">→</span></a>
              {% else %}
                <p class="tg-card__availability">Coming Soon</p>
              {% endunless %}
            </div>
          </article>
        {% endfor %}
        {% for block in section.blocks %}
          {% if block.settings.coming_soon and has_coming_soon_product == false %}
            {% liquid
              assign img = block.settings.image
              assign tag = block.settings.tag
              assign title = block.settings.title
              assign desc = block.settings.desc
              assign features_str = block.settings.features
            %}
            <article class="tg-card tg-card--daily tg-card--coming-soon" role="listitem" {{ block.shopify_attributes }}>
              <div class="tg-card__media-wrap">
                <div class="tg-card__media">
                  {% if img != blank %}
                    {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'tg-card__img', alt: title }}
                  {% else %}
                    <div class="tg-card__img tg-card__img--ph" aria-hidden="true"></div>
                  {% endif %}
                  <div class="tg-card__media-overlay" aria-hidden="true"></div>
                  <div class="tg-card__coming-soon-overlay">
                    <span class="tg-card__coming-soon-badge">Coming Soon</span>
                  </div>
                  <div class="tg-card__media-content">
                    {% if tag != blank %}<p class="tg-card__meta">{{ tag }}</p>{% endif %}
                    {% if title != blank %}<h3 class="tg-card__title">{{ title }}</h3>{% endif %}
                    {% if desc != blank %}<p class="tg-card__media-desc">{{ desc }}</p>{% endif %}
                  </div>
                </div>
              </div>
              <div class="tg-card__body">
                <h3 class="tg-card__body-title">{{ title | escape }}</h3>
                {% if desc != blank %}<p class="tg-card__desc">{{ desc }}</p>{% endif %}
                {% if features_str != blank %}
                  {% assign features_list = features_str | strip | newline_to_br | replace: '<br>', '<br />' | split: '<br />' %}
                  <ul class="tg-card__features">
                    {% for f in features_list %}
                      {% assign item = f | strip %}
                      {% if item != blank %}<li>{{ item }}</li>{% endif %}
                    {% endfor %}
                  </ul>
                {% endif %}
                <p class="tg-card__availability">Coming Soon</p>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% liquid
            assign img = block.settings.image
            assign tag = block.settings.tag
            assign title = block.settings.title
            assign desc = block.settings.desc
            assign body_desc = desc
            assign features_str = block.settings.features
            assign btn_label = 'Explore Journey'
            assign btn_link = block.settings.btn_link
            assign is_coming_soon = block.settings.coming_soon
          %}
          <article class="tg-card tg-card--daily{% if is_coming_soon %} tg-card--coming-soon{% endif %}" role="listitem" {{ block.shopify_attributes }}>
            <div class="tg-card__media-wrap">
              {% if is_coming_soon %}<div class="tg-card__media">{% else %}<a class="tg-card__media" href="{{ btn_link | default: '#' }}" aria-label="{{ title | escape }}">{% endif %}
                {% if img != blank %}
                  {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'tg-card__img', alt: title }}
                {% else %}
                  <div class="tg-card__img tg-card__img--ph" aria-hidden="true"></div>
                {% endif %}
                <div class="tg-card__media-overlay" aria-hidden="true"></div>
                {% if is_coming_soon %}
                  <div class="tg-card__coming-soon-overlay">
                    <span class="tg-card__coming-soon-badge">Coming Soon</span>
                  </div>
                {% endif %}
                <div class="tg-card__media-content">
                  {% if tag != blank %}
                    <p class="tg-card__meta">{{ tag }}</p>
                  {% endif %}
                  {% if title != blank %}
                    <h3 class="tg-card__title">{{ title }}</h3>
                  {% endif %}
                  {% if desc != blank %}
                    <p class="tg-card__media-desc">{{ desc }}</p>
                  {% endif %}
                </div>
              {% if is_coming_soon %}</div>{% else %}</a>{% endif %}
            </div>
            <div class="tg-card__body">
              <h3 class="tg-card__body-title">{{ title | escape }}</h3>
              {% if body_desc != blank %}
                <p class="tg-card__desc">{{ body_desc }}</p>
              {% endif %}
              {% if features_str != blank %}
                {% assign features_list = features_str | strip | newline_to_br | replace: '<br>', '<br />' | split: '<br />' %}
                <ul class="tg-card__features">
                  {% for f in features_list %}
                    {% assign item = f | strip %}
                    {% if item != blank %}<li>{{ item }}</li>{% endif %}
                  {% endfor %}
                </ul>
              {% endif %}
              {% unless is_coming_soon %}
                <a class="tg-card__btn" href="{{ btn_link | default: '#' }}">{{ btn_label }} <span aria-hidden="true">→</span></a>
              {% else %}
                <p class="tg-card__availability">Coming Soon</p>
              {% endunless %}
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .tg-exp{
    background: var(--tg-bg);
    padding: 0;
  }
  .tg-exp__inner{
    padding-top: clamp(124px, 5vw, 86px);
    padding-bottom: clamp(124px, 5vw, 86px);
  }

  .tg-exp .tg-hero{ position: relative; }
  .tg-exp .tg-hero__media{
    position: relative;
    height: var(--tg-hero-h);
    max-height: 399px;
    overflow: hidden;
    background: #0b0b0c;
    border-bottom: 1px solid rgba(0,0,0,.06);
  }
  .tg-exp .tg-hero__media img{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    opacity: .95;
  }
  .tg-exp .tg-hero__media--fallback{
    background:
      radial-gradient(900px 420px at 20% 30%, rgba(255,255,255,.10), transparent 60%),
      radial-gradient(720px 380px at 70% 20%, rgba(255,255,255,.08), transparent 55%),
      linear-gradient(135deg, #0b0b0c, #15121b);
  }
  .tg-exp .tg-hero__overlay{
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,var(--tg-overlay-top)) 0%,
      rgba(0,0,0,var(--tg-overlay-mid)) 55%,
      rgba(0,0,0,var(--tg-overlay-bot)) 100%
    );
  }
  .tg-exp .tg-hero__content{
    position: relative;
    z-index: 3;
    height: var(--tg-hero-h);
    max-height: 399px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tg-exp .tg-title{
    position: relative;
    margin: 0;
    max-width: var(--tg-title-max);
    text-align: var(--tg-title-align);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: clamp(38px, 4vw, 52px);
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.12;
    color: #fff;
  }
  .tg-exp .tg-title__text{
    position: relative;
    z-index: 2;
    display: inline-block;
  }
  .tg-exp .tg-title__bg{
    position: absolute;
    z-index: 1;
    left: calc(-1 * var(--tg-title-pad-x));
    right: calc(-1 * var(--tg-title-pad-x));
    top: calc(-1 * var(--tg-title-pad-y));
    bottom: calc(-1 * var(--tg-title-pad-y));
    border-radius: var(--tg-title-bg-radius);
    background: linear-gradient(
      90deg,
      rgba(0,0,0,var(--tg-title-bg-opacity)) 0%,
      rgba(0,0,0,0) 92%
    );
  }

  .tg-exp__section-title{
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--tg-title);
    margin: 0 0 8px;
    text-align: center;
  }
  .tg-exp__sub{
    margin: 0 0 32px;
    text-align: center;
    color: var(--tg-muted);
    font-size: 15px;
    line-height: 1.6;
    max-width: 50ch;
    margin-left: auto;
    margin-right: auto;
  }
  .tg-exp__grid{
    margin-top: clamp(22px, 3vw, 36px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: var(--tg-gap);
  }
  .tg-exp__grid--daily{
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px);
  }

  .tg-card{
    border-radius: var(--tg-radius);
    overflow: hidden;
    background: transparent;
  }
  .tg-card--daily{
    display: flex;
    flex-direction: column;
    background: #fff;
    box-shadow: 0 1px 12px rgba(0,0,0,.06);
    border-radius: var(--tg-radius);
    overflow: hidden;
    transition: box-shadow 0.25s ease;
  }
  .tg-card--daily:hover{
    box-shadow: 0 4px 24px rgba(0,0,0,.08);
  }
  .tg-card--coming-soon{
    pointer-events: none;
    opacity: 0.72;
  }
  .tg-card--coming-soon .tg-card__media{
    cursor: default;
  }
  .tg-card__coming-soon-overlay{
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.42);
  }
  .tg-card__coming-soon-badge{
    display: inline-block;
    padding: 10px 22px;
    border-radius: 999px;
    background: rgba(255,255,255,0.15);
    border: 1.5px solid rgba(255,255,255,0.55);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }

  .tg-card__media-wrap{
    position: relative;
    flex-shrink: 0;
    background: #000;
  }
  .tg-card__media-wrap::after{
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.15);
    pointer-events: none;
    z-index: 2;
  }
  .tg-card__media{
    position: relative;
    display: block;
    overflow: hidden;
    background: #000;
  }
  .tg-card--daily .tg-card__media{
    aspect-ratio: 4 / 5;
  }
  .tg-card__media-slider{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .tg-card__media-track{
    position: relative;
    width: 100%;
    height: 100%;
  }
  .tg-card__media-slide{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }
  .tg-card__media-slide.is-active{
    opacity: 1;
  }
  .tg-card__img{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    vertical-align: middle;
  }
  .tg-card__media-dots{
    position: absolute;
    top: 14px;
    left: 16px;
    right: 16px;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0;
  }
  .tg-card__media-dot{
    flex: 1 1 0;
    min-width: 0;
    height: 4px;
    border-radius: 999px;
    background: rgba(255,255,255,0.35);
    flex-shrink: 0;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }
  .tg-card__media-dot.is-active{
    background: #fff;
    opacity: 1;
  }
  .tg-card--daily .tg-card__media-overlay{
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgba(0,0,0,0.1);
  }
  .tg-card--daily .tg-card__media-content{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 3;
    padding: 36px 20px 24px;
    text-align: center;
  }
  .tg-card--daily .tg-card__media-content .tg-card__meta{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
    padding: 7px 14px;
    border-radius: 999px;
    background: #ffd400;
    color: #1f1f1f;
    margin: 0 auto 10px;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 1;
  }
  .tg-card--daily .tg-card__media-content .tg-card__title{
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: 0.02em;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0,0,0,.22);
    text-align: center;
  }
  .tg-card--daily .tg-card__media-desc{
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: -12px;
    margin: 0;
    color: #fff;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.45;
    text-align: center;
    text-shadow: 0 2px 10px rgba(0,0,0,.28);
    z-index: 3;
  }
  .tg-card__img--ph{
    width: 100%;
    height: 100%;
    background:
      radial-gradient(800px 400px at 20% 25%, rgba(0,0,0,.08), transparent 60%),
      linear-gradient(135deg, rgba(0,0,0,.06), rgba(0,0,0,.02));
  }

  .tg-card__overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    color: #fff;
    background: linear-gradient(180deg, rgba(0,0,0,.22), rgba(0,0,0,.55));
  }
  .tg-card--daily .tg-card__overlay{ display: none; }
  .tg-card__tag{
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .85;
  }
  .tg-card__overlayTitle{
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 650;
    line-height: 1.15;
    text-shadow: 0 2px 10px rgba(0,0,0,.25);
  }
  .tg-card__overlaySub{
    margin-top: 4px;
    font-size: 14px;
    opacity: .92;
    text-shadow: 0 2px 10px rgba(0,0,0,.25);
  }
  .tg-card__location{
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    opacity: .9;
  }

  .tg-card__body{
    padding: 14px 6px 0;
    text-align: center;
    display: block;
  }
  .tg-card--daily .tg-card__body{
    flex: 1;
    display: flex !important;
    flex-direction: column;
    padding: 24px 24px 28px;
