<script>
  (function() {
    var sliders = document.querySelectorAll('[data-tg-card-slider]');
    if (!sliders.length) return;

    sliders.forEach(function(slider) {
      var track = slider.querySelector('[data-tg-card-track]');
      var slides = slider.querySelectorAll('[data-tg-card-slide]');
      var dots = slider.querySelectorAll('.tg-card__media-dot');
      var currentIndex = 0;
      var intervalId = null;
      var startX = 0;
      var deltaX = 0;

      if (!track || slides.length <= 1) return;

      function update() {
        slides.forEach(function(slide, index) {
          slide.classList.toggle('is-active', index === currentIndex);
        });
        dots.forEach(function(dot, index) {
          dot.classList.toggle('is-active', index === currentIndex);
        });
      }

      function goTo(index) {
        currentIndex = (index + slides.length) % slides.length;
        update();
      }

      function startAuto() {
        stopAuto();
        intervalId = window.setInterval(function() {
          goTo(currentIndex + 1);
        }, 6000);
      }

      function stopAuto() {
        if (intervalId) {
          window.clearInterval(intervalId);
          intervalId = null;
        }
      }

      slider.addEventListener('mouseenter', stopAuto);
      slider.addEventListener('mouseleave', startAuto);

      slider.addEventListener('touchstart', function(event) {
        stopAuto();
        startX = event.touches[0].clientX;
        deltaX = 0;
      }, { passive: true });

      slider.addEventListener('touchmove', function(event) {
        deltaX = event.touches[0].clientX - startX;
      }, { passive: true });

      slider.addEventListener('touchend', function() {
        if (Math.abs(deltaX) > 40) {
          goTo(deltaX < 0 ? currentIndex + 1 : currentIndex - 1);
        }
        startAuto();
      });

      update();
      startAuto();
    });
  })();
</script>

