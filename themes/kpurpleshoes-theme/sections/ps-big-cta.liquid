<section class="ps-bigcta">
  <div class="ps-container">
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- liquid
      assign cta_label = section.settings.guest_button_label | default: 'Get My Free Guide'
      assign cta_href = section.settings.guest_button_link | default: '/pages/freeguideoptin'
      if request.page_type == 'index'
        assign cta_href = '/customer_authentication/login?return_to=%2Fpages%2Fstarter-kit-viewer'
      endif
      if customer
        assign cta_label = section.settings.customer_button_label | default: 'Explore Now'
        assign cta_href = section.settings.customer_button_link | default: routes.root_url
      endif
    -%}

    <a href="{{ cta_href }}" class="ps-btn ps-btn--yellow">
      {{ cta_label }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "PS Big CTA (Newsletter)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Plan your Korea trip the smart way — start with a free guide." },
    { "type": "text", "id": "guest_button_label", "label": "Guest button label", "default": "Get My Free Guide" },
    { "type": "url", "id": "guest_button_link", "label": "Guest button link" },
    { "type": "text", "id": "customer_button_label", "label": "Logged-in button label", "default": "Explore Now" },
    { "type": "url", "id": "customer_button_link", "label": "Logged-in button link" }
  ],
  "presets": [
    { "name": "PS Big CTA (Newsletter)" }
  ]
}
{% endschema %}
