{{ 'starter-kit-viewer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign default_cta_label = 'starter_kit_viewer.cta_label' | t
  assign cta_label = section.settings.cta_label | default: default_cta_label
  assign guide_kit_url = section.settings.guide_kit_url | default: '/pages/guide-plans'
  assign hero_image = section.settings.hero_image | default: images['938207a5477970309a67488f9a0400dc.png']
  assign map_video_url = 'purple-map-demo.mp4' | asset_url
  if section.settings.map_video_url != blank
    assign map_video_url = section.settings.map_video_url
  endif
-%}

<section
  class="skv"
  data-section="starter-kit-viewer"
>
  <header class="skv__hero">
    {%- if hero_image != blank -%}
      {{ hero_image | image_url: width: 1800 | image_tag: class: 'skv__hero-image', loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1800', sizes: '(min-width: 1250px) 1200px, 100vw', alt: '' }}
    {%- endif -%}
    <div class="skv__hero-copy">
      <p class="skv__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="skv__title">{{ section.settings.title | escape | newline_to_br }}</h1>
      <p class="skv__subtitle">{{ section.settings.subtitle | escape | newline_to_br }}</p>
    </div>
    <div class="skv__hero-offer">
      <h2 class="skv__offer-title">{{ 'starter_kit_viewer.offer_heading' | t }}</h2>
      <a class="skv__cta" data-skv-cta href="{{ guide_kit_url | escape }}">{{ cta_label | escape }}{% render 'starter-kit-icon', name: 'chevron' %}</a>
    </div>
  </header>

  <div class="skv__content">
    <div class="skv__grid">
      <article class="skv__card">
        <div class="skv__card-head">
          <h2 class="skv__card-title">{{ section.settings.video_title | default: 'Starter Kit Video' }}</h2>
          <p class="skv__card-copy">{{ section.settings.video_copy | default: 'Watch the essential travel tips for your first Korea trip.' | newline_to_br }}</p>
        </div>
        {% if section.settings.video_url != blank %}
          <video class="skv__video" controls playsinline preload="metadata" controlsList="nodownload noremoteplayback" disablepictureinpicture>
            <source src="{{ section.settings.video_url | escape }}">
            {{ 'starter_kit_viewer.video_fallback' | t }}
          </video>
        {% else %}
          <p class="skv__empty">{{ 'starter_kit_viewer.video_unavailable' | t }}</p>
        {% endif %}
      </article>

      <article class="skv__card">
        <div class="skv__card-head">
          <div class="skv__card-title-row">
          <h2 class="skv__card-title">{{ section.settings.pdf_title | default: 'Starter Kit Guidebook' }}</h2>
            {% if section.settings.pdf_url != blank %}
              <button class="skv__fullscreen-btn" type="button" data-skv-pdf-fullscreen data-skv-pdf-target="StarterKitPdf-{{ section.id }}" aria-label="{{ 'starter_kit_viewer.fullscreen_label' | t | escape }}">
                <span aria-hidden="true">⛶</span> {{ 'starter_kit_viewer.fullscreen' | t }}
              </button>
            {% endif %}
          </div>
          <p class="skv__card-copy">{{ section.settings.pdf_copy | default: 'Read the essential Korea travel information at your own pace.' | newline_to_br }}</p>
        </div>
        {% if section.settings.pdf_url != blank %}
          <div class="skv__pdf-mobile" id="StarterKitPdf-{{ section.id }}" data-pdf-url="{{ section.settings.pdf_url | escape }}" data-skv-pdf-mobile data-page-description="{{ 'starter_kit_viewer.page_description' | t: number: '__NUMBER__', total: 48 | escape }}" aria-label="{{ section.settings.pdf_title | default: 'Starter Guide PDF' | escape }}">
            <div class="skv__pdf-toolbar">
              <button type="button" data-skv-pdf-prev disabled aria-label="{{ 'starter_kit_viewer.previous_label' | t | escape }}">{{ 'starter_kit_viewer.previous' | t }}</button>
              <span data-skv-pdf-count aria-live="polite">1 / 48</span>
              <button type="button" data-skv-pdf-next disabled aria-label="{{ 'starter_kit_viewer.next_label' | t | escape }}">{{ 'starter_kit_viewer.next' | t }}</button>
              <button type="button" data-skv-pdf-close aria-label="{{ 'starter_kit_viewer.close_label' | t | escape }}">{{ 'starter_kit_viewer.close' | t }}</button>
            </div>
            <div class="skv__pdf-page"><img data-skv-pdf-image src="{{ 'starter-guide-page-01.jpg' | asset_url }}" alt="{{ 'starter_kit_viewer.page_description' | t: number: 1, total: 48 | escape }}" width="1445" height="2045" loading="lazy"></div>
            <div hidden>
              {% for page_number in (1..48) %}
                {% assign page_suffix = page_number | prepend: '0' | slice: -2, 2 %}
                {% assign page_asset = 'starter-guide-page-' | append: page_suffix | append: '.jpg' %}
                <span data-skv-pdf-page-url="{{ page_asset | asset_url }}"></span>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <p class="skv__empty">{{ 'starter_kit_viewer.pdf_unavailable' | t }}</p>
        {% endif %}
      </article>
    </div>

    <section class="skv__comparison" aria-labelledby="SkvComparison-{{ section.id }}">
      <h2 class="skv__comparison-title" id="SkvComparison-{{ section.id }}">{{ 'starter_kit_viewer.comparison_heading' | t }}</h2>
      <p class="skv__comparison-copy">{{ 'starter_kit_viewer.comparison_copy' | t }}</p>
      <div class="skv__comparison-grid">
        <article class="skv__compare-card">
          <h3 class="skv__compare-title">{{ 'starter_kit_viewer.free_title' | t }}</h3>
          <p class="skv__compare-sub">{{ 'starter_kit_viewer.free_subtitle' | t }}</p>
          <ul class="skv__compare-list">
            <li class="skv__compare-item"><span class="skv__icon">{% render 'starter-kit-icon', name: 'clipboard' %}</span><p>{{ 'starter_kit_viewer.free_prep' | t }}</p></li>
            <li class="skv__compare-item"><span class="skv__icon">{% render 'starter-kit-icon', name: 'train' %}</span><p>{{ 'starter_kit_viewer.free_transport' | t }}</p></li>
            <li class="skv__compare-item"><span class="skv__icon">{% render 'starter-kit-icon', name: 'pin' %}</span><p>{{ 'starter_kit_viewer.free_map' | t }}</p></li>
          </ul>
        </article>
        <span class="skv__compare-arrow" aria-hidden="true">{% render 'starter-kit-icon', name: 'arrow' %}</span>
        <article class="skv__compare-card skv__compare-card--full">
          <h3 class="skv__compare-title">{{ 'starter_kit_viewer.full_title' | t }}</h3>
          <p class="skv__compare-sub">{{ 'starter_kit_viewer.full_subtitle' | t }}</p>
          <ul class="skv__compare-list">
            <li class="skv__compare-item"><span class="skv__icon">{% render 'starter-kit-icon', name: 'food' %}</span><p>{{ 'starter_kit_viewer.full_food' | t }}</p></li>
            <li class="skv__compare-item"><span class="skv__icon">{% render 'starter-kit-icon', name: 'map' %}</span><p>{{ 'starter_kit_viewer.full_regions' | t }}</p></li>
            <li class="skv__compare-item"><span class="skv__icon">{% render 'starter-kit-icon', name: 'navigation' %}</span><p>{{ 'starter_kit_viewer.full_map' | t }}<span class="skv__map-helper">{{ 'starter_kit_viewer.map_helper' | t }}</span></p></li>
          </ul>
          <div class="skv__composition"><span class="skv__icon">{% render 'starter-kit-icon', name: 'book' %}</span><p><strong>{{ 'starter_kit_viewer.composition' | t }}</strong><br>{{ 'starter_kit_viewer.access' | t }}</p></div>
        </article>
      </div>
      <div class="skv__trust">{% render 'starter-kit-icon', name: 'heart' %}<p><strong>{{ 'starter_kit_viewer.trust_heading' | t }}</strong><br>{{ 'starter_kit_viewer.trust_copy' | t }}</p></div>
    </section>

    <section class="skv__map-demo" aria-labelledby="SkvMap-{{ section.id }}">
      <div>
        <h2 class="skv__map-title" id="SkvMap-{{ section.id }}">{{ 'starter_kit_viewer.map_heading' | t }}</h2>
        <p class="skv__map-copy">{{ 'starter_kit_viewer.map_copy' | t }}</p>
        <p class="skv__map-caption">{{ 'starter_kit_viewer.map_helper' | t }}</p>
      </div>
      <div class="skv__map-media">
        <h3 class="skv__map-label">{{ 'starter_kit_viewer.map_video_heading' | t }}</h3>
        <div class="skv__map-frame" data-skv-map-frame>
          <video class="skv__map-video" data-skv-map-video controls playsinline preload="none" poster="{{ 'purple-map-demo-poster.jpg' | asset_url }}" aria-label="{{ 'starter_kit_viewer.map_video_heading' | t | escape }}">
            <source src="{{ map_video_url | escape }}" type="video/mp4">
            {{ 'starter_kit_viewer.video_fallback' | t }}
          </video>
          <button class="skv__map-play" type="button" data-skv-map-play hidden aria-label="{{ 'starter_kit_viewer.map_play' | t | escape }}">{% render 'starter-kit-icon', name: 'play' %}</button>
        </div>
        <p class="skv__map-status" data-skv-map-status hidden role="status">{{ 'starter_kit_viewer.map_error' | t }}</p>
      </div>
    </section>

    <div class="skv__next" data-skv-next>
      <a class="skv__cta" data-skv-cta href="{{ guide_kit_url | escape }}">{{ cta_label | escape }}{% render 'starter-kit-icon', name: 'chevron' %}</a>
      <p>{{ 'starter_kit_viewer.cta_helper' | t }}</p>
    </div>
  </div>
</section>

<script src="{{ 'starter-kit-viewer.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Starter Kit Viewer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Free Starter Kit"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Your Korea Trip\nStarts Here"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Start with the essentials.\nWatch the video and read the guide at your own pace."
    },
    {
      "type": "header",
      "content": "Starter video"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Title",
      "default": "Starter Kit Video"
    },
    {
      "type": "textarea",
      "id": "video_copy",
      "label": "Description",
      "default": "Watch the essential travel tips for your first Korea trip."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Starter PDF"
    },
    {
      "type": "text",
      "id": "pdf_title",
      "label": "Title",
      "default": "Starter Kit Guidebook"
    },
    {
      "type": "textarea",
      "id": "pdf_copy",
      "label": "Description",
      "default": "Read the essential Korea travel information at your own pace."
    },
    {
      "type": "url",
      "id": "pdf_url",
      "label": "PDF URL"
    },
    {
      "type": "header",
      "content": "Guide Kit details"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore the Full Korea Guide Kit"
    },
    {
      "type": "url",
      "id": "guide_kit_url",
      "label": "Korea Guide Kit page URL"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero photo"
    },
    {
      "type": "url",
      "id": "map_video_url",
      "label": "Purple Map demonstration video URL",
      "info": "Leave blank to use the supplied Purple Map demonstration video."
    }
  ],
  "presets": [
    {
      "name": "Starter Kit Viewer"
    }
  ]
}
{% endschema %}
