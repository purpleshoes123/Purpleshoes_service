  /* CTA selection */
  .tg-upsell-modal__selection{ display:flex; flex-direction:column; gap:10px; margin-bottom:10px; }
  .tg-upsell-option{ cursor:pointer; margin:0; display:block; }
  .tg-upsell-option__input{ position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); border:0; }
