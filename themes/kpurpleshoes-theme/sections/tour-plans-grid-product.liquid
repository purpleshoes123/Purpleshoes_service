    function calculateGuideKitDiscountedCents(priceCents, displayContext) {
      var discountedCents = priceCents;
      if (displayContext && typeof displayContext.guide50Rate === 'number') {
        discountedCents = Math.round(priceCents * displayContext.guide50Rate);
      }
      if (displayContext && displayContext.extra10Cents > 0) {
        discountedCents = Math.max(0, discountedCents - displayContext.extra10Cents);
      }
      return discountedCents;
    }

