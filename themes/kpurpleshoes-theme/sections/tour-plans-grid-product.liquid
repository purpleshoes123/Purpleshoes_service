{% comment %}
  Tour Plans - Plans Grid (Product)
  - Uses the latest DtdxpE visual layout
  - Keeps full product-grid functionality (variant pricing, checkout flow, upsell modal, coupon discount display)
{% endcomment %}
{{ 'guide-extension.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bta-theme-cart-checkout.js' | asset_url }}" defer></script>
<script src="{{ 'guide-extension.js' | asset_url }}" defer></script>

<section
  class="tg-pricing"
  id="choose-your-best-plan"
  data-tg-plans
  style="--tg-primary: {{ section.settings.primary_color | default: '#5b2bd8' }};"
>
  <script>
    window.__customerId = {{ customer.id | json }};
  </script>
  <div class="tg-pricing__inner">
    <header class="tg-pricing__head">
      <h2 class="tg-pricing__title">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="tg-pricing__sub">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    {% if section.settings.show_discount_banner %}
      <div class="tg-discount-banner">
        <strong>Member savings apply automatically</strong>
        <p>Eligible guide discounts are added automatically for signed-in customers during checkout.</p>
      </div>
    {% endif %}

    {% assign featured_variant = null %}
    {% assign featured_variant_price = 0 %}
    {% for variant in product.variants %}
      {% assign plan = variant.metafields.plan %}
      {% if plan.is_featured.value == true %}
        {% assign featured_variant = variant %}
        {% break %}
      {% endif %}
      {% if variant.price > featured_variant_price %}
        {% assign featured_variant = variant %}
        {% assign featured_variant_price = variant.price %}
      {% endif %}
    {% endfor %}

    <div class="tg-pricing__grid" role="list">
      {% assign card_index = 0 %}

      {% for pass in (1..2) %}
        {% for variant in product.variants %}
          {% assign plan = variant.metafields.plan %}
          {% assign has_sort = false %}
          {% if plan.sort_order.value %}
            {% assign has_sort = true %}
          {% endif %}

          {% if pass == 1 and has_sort == false %}{% continue %}{% endif %}
          {% if pass == 2 and has_sort == true %}{% continue %}{% endif %}

          {% assign card_index = card_index | plus: 1 %}

          {% assign is_featured = plan.is_featured.value | default: false %}
          {% assign badge_soft = plan.card_tag.value | default: 'BASIC' %}
          {% assign badge_solid = plan.badge_text.value | default: 'BEST VALUE' %}
          {% assign plan_name = plan.card_title.value | default: variant.title %}
          {% assign plan_desc = plan.card_subtitle.value | default: '' %}
          {% assign features = plan.features.value | default: '' %}
          {% assign features_excluded = plan.features_excluded.value | default: '' %}
          {% assign btn_label = plan.cta_label.value | default: 'Select plan' %}
          {% assign display_price = variant.price | money %}

          {% assign matched_block = null %}
          {% assign bi = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'plan_image' %}
              {% assign bi = bi | plus: 1 %}
              {% if bi == card_index %}
                {% assign matched_block = block %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if matched_block %}
            {% if matched_block.settings.override_title != blank %}{% assign plan_name = matched_block.settings.override_title %}{% endif %}
            {% if matched_block.settings.override_subtitle != blank %}{% assign plan_desc = matched_block.settings.override_subtitle %}{% endif %}
            {% if matched_block.settings.override_tag != blank %}{% assign badge_soft = matched_block.settings.override_tag %}{% endif %}
            {% if matched_block.settings.override_badge != blank %}{% assign badge_solid = matched_block.settings.override_badge %}{% endif %}
            {% if matched_block.settings.override_cta != blank %}{% assign btn_label = matched_block.settings.override_cta %}{% endif %}
            {% if matched_block.settings.override_price != blank %}{% assign display_price = matched_block.settings.override_price %}{% endif %}
          {% endif %}

          <article
            class="tg-pricing-card{% if is_featured %} tg-pricing-card--featured{% endif %}"
            role="listitem"
            data-guidekit-featured="{% if is_featured %}true{% else %}false{% endif %}"
            data-guidekit-price-cents="{{ variant.price }}"
            {% if matched_block %}{{ matched_block.shopify_attributes }}{% endif %}
          >
            <div class="tg-pricing-card__badge-row">
              {% if is_featured %}
                <div class="tg-pricing-card__bar" aria-hidden="true">{{ badge_solid }}</div>
              {% else %}
                <div class="tg-pricing-card__bar tg-pricing-card__bar--ghost" aria-hidden="true"></div>
              {% endif %}
            </div>

            <h3 class="tg-pricing-card__plan">{{ plan_name }}</h3>

            <div class="tg-pricing-card__price" aria-label="Price">
              <span class="tg-pricing-card__amount">{{ display_price }}</span>
              <span class="tg-pricing-card__discount" data-guidekit-discounted-price style="display:none;"></span>
              <span class="tg-pricing-card__discount-note" data-guidekit-discount-note hidden></span>
            </div>

            <p class="tg-pricing-card__pay-once">No subscription. Pay once.</p>

            {% if is_featured %}
              <div class="tg-pricing-card__countdown-wrap" data-guidekit-countdown role="status" aria-live="polite" aria-hidden="true" hidden>
                <span class="tg-pricing-card__countdown-label" style="color: #ffffff;">Your 50% welcome offer ends in</span>
                <span class="tg-pricing-card__countdown-num" data-guidekit-countdown-text>00:00:00</span>
              </div>
            {% else %}
              <div class="tg-pricing-card__countdown-placeholder" aria-hidden="true" hidden></div>
            {% endif %}

            {% if variant.available %}
              <a class="tg-pricing-card__btn"
                href="#"
                data-guide-checkout
                data-variant-id="{{ variant.id }}"
                data-is-featured="{% if is_featured %}true{% else %}false{% endif %}"
                aria-label="Select plan: {{ plan_name }}">
                {{ btn_label }}
              </a>
            {% else %}
              <button class="tg-pricing-card__btn tg-pricing-card__btn--disabled" type="button" disabled>Sold out</button>
            {% endif %}
          </article>
        {% endfor %}
      {% endfor %}
    </div>

    {% if section.settings.show_compare %}
      <div class="tg-compare" aria-label="Plan comparison">
        <div class="tg-compare__grid">

          <div class="tg-compare__col">
            <div class="tg-compare__col-head">Guidebook ONLY</div>
            <ul class="tg-compare__list">
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Guidebook</li>
              <li class="tg-compare__item tg-compare__item--no">Video Guide</li>
              <li class="tg-compare__item tg-compare__item--no">1,000+ Local Foodie Hidden Gems</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Offline Viewing</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Up to 2 devices</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>90-days access</li>
              <li class="tg-compare__item tg-compare__item--no">15% Off Experience Tour Coupon</li>
              <li class="tg-compare__item tg-compare__item--no">Purple Map — 1,500+ handpicked spots</li>
            </ul>
          </div>

          <div class="tg-compare__col tg-compare__col--featured">
            <div class="tg-compare__col-head">Korea Guide Kit</div>
            <ul class="tg-compare__list">
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Guidebook</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Video Guide</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>1,000+ Local Foodie Hidden Gems</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Offline Viewing</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Up to 3 devices</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>180-days access</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>15% Off Experience Tour Coupon</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Purple Map — 1,500+ handpicked spots</li>
            </ul>
          </div>

          <div class="tg-compare__col">
            <div class="tg-compare__col-head">Video Guide ONLY</div>
            <ul class="tg-compare__list">
              <li class="tg-compare__item tg-compare__item--no">Guidebook</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Video Guide</li>
              <li class="tg-compare__item tg-compare__item--no">1,000+ Local Foodie Hidden Gems</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Offline Viewing</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Up to 2 devices</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>90-days access</li>
              <li class="tg-compare__item tg-compare__item--no">15% Off Experience Tour Coupon</li>
              <li class="tg-compare__item tg-compare__item--no">Purple Map — 1,500+ handpicked spots</li>
            </ul>
          </div>

        </div>
      </div>
    {% endif %}

    {% if section.settings.show_tip %}
      <div class="tg-pricing__tip">
        <div class="tg-pricing__tip-box">
          <strong>{{ section.settings.tip_title }}</strong>
          <div class="tg-pricing__tip-text rte">{{ section.settings.tip_text }}</div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% comment %} Upsell Modal — thank-you-offer style {% endcomment %}
{% if featured_variant %}
  {% assign featured_plan = featured_variant.metafields.plan %}
  {% assign sale_active = false %}
  {% if section.settings.upsell_sale_enabled and section.settings.upsell_sale_ends_at != blank %}
    {% assign sale_active = true %}
  {% endif %}
  <div class="tg-upsell-modal"
       id="tg-upsell-modal"
       role="dialog"
       aria-modal="true"
       aria-labelledby="tg-upsell-modal-title"
       data-featured-variant-id="{{ featured_variant.id }}"
       data-featured-price-cents="{{ featured_variant.price }}"
       style="display: none;">
    <div class="tg-upsell-modal__overlay"></div>
    <div class="tg-upsell-modal__content" data-upsell-timer-duration="{{ section.settings.upsell_timer_duration_seconds | default: 3600 }}">
      <button class="tg-upsell-modal__close" type="button" aria-label="Close modal">&times;</button>

      <!-- ── Offer View ── -->
      <div class="tg-upsell-modal__view tg-upsell-modal__offer tg-upsell-modal__view--active" data-upsell-view="offer">
        <div class="tg-upsell-modal__scroll">

          <!-- Flash banner -->
          <div class="tg-upsell-modal__flash" aria-label="Limited time offer">
            {{ section.settings.upsell_countdown_label | default: "24-Hour Flash Sale" }}
          </div>

          <!-- Header (white) -->
          <div class="tg-upsell-modal__header">
            <p class="tg-upsell-modal__eyebrow">{{ section.settings.eyebrow_text | default: "Wait! Upgrade to the Full Kit & Save 50%" }}</p>
            <h3 id="tg-upsell-modal-title" class="tg-upsell-modal__title">
              {{ featured_plan.card_title.value | default: featured_variant.title }}
            </h3>
            {% if featured_plan.card_subtitle.value != blank %}
              <p class="tg-upsell-modal__subtitle">{{ featured_plan.card_subtitle.value }}</p>
            {% endif %}
          </div>

          <!-- Offer card (dark purple) -->
          <div class="tg-upsell-modal__offer-card">

            <!-- Optional ISO-date flash sale header -->
            {% if section.settings.upsell_sale_enabled and section.settings.upsell_sale_ends_at != blank %}
            <div class="tg-upsell-modal__sale-header" data-sale-header>
              <p class="tg-upsell-modal__sale-headline">{{ section.settings.upsell_headline }}</p>
              <p class="tg-upsell-modal__sale-sub">{{ section.settings.upsell_subheadline }}</p>
              <div class="tg-upsell-modal__timer" data-countdown-timer>
                <span class="tg-upsell-modal__timer-cell"><span class="tg-upsell-modal__timer-num" data-timer-hours>00</span><span class="tg-upsell-modal__timer-unit">Hours</span></span>
                <span class="tg-upsell-modal__timer-cell"><span class="tg-upsell-modal__timer-num" data-timer-minutes>00</span><span class="tg-upsell-modal__timer-unit">Minutes</span></span>
                <span class="tg-upsell-modal__timer-cell"><span class="tg-upsell-modal__timer-num" data-timer-seconds>00</span><span class="tg-upsell-modal__timer-unit">Seconds</span></span>
              </div>
            </div>
            {% endif %}

            <!-- Price block -->
            <div class="tg-upsell-modal__price-block">
              <p class="tg-upsell-modal__offer-label">Exclusive Offer: Get the Korea Guide Kit for just</p>
              <div class="tg-upsell-modal__price-hero">
                <span class="tg-upsell-modal__price-now">{{ featured_variant.price | money }}</span>
                {% if featured_variant.compare_at_price > featured_variant.price %}
                <span class="tg-upsell-modal__price-was"><s>{{ featured_variant.compare_at_price | money }}</s></span>
                {% endif %}
              </div>
              <div class="tg-upsell-modal__price-discounted" data-guidekit-modal-discounted-price style="display:none;"></div>
              <p class="tg-upsell-modal__price-note" data-guidekit-modal-discount-note hidden></p>
            </div>

            <!-- Duration countdown (guide50 timer) -->
            <div class="tg-upsell-modal__countdown-bar" data-upsell-countdown-bar role="region" aria-live="polite">
              <p class="tg-upsell-modal__countdown-headline" data-upsell-countdown-headline style="display:none"></p>
              <p class="tg-upsell-modal__countdown-expired" data-upsell-countdown-expired aria-hidden="true">{{ section.settings.upsell_countdown_expired_text | default: "This offer has expired." }}</p>
              <div class="tg-upsell-modal__countdown-timer" data-upsell-timer>
                <span class="tg-upsell-modal__countdown-bracket">[ Time Remaining:&nbsp;</span>
                <span class="tg-upsell-modal__countdown-num" data-upsell-timer-h>00</span>
                <span class="tg-upsell-modal__countdown-sep">:</span>
                <span class="tg-upsell-modal__countdown-num" data-upsell-timer-m>00</span>
                <span class="tg-upsell-modal__countdown-sep">:</span>
                <span class="tg-upsell-modal__countdown-num" data-upsell-timer-s>00</span>
                <span class="tg-upsell-modal__countdown-bracket">&nbsp;]</span>
              </div>
            </div>

            <!-- Scissors divider -->
            <div class="tg-upsell-modal__scissors" aria-hidden="true">
              <span class="tg-upsell-modal__scissors-line"></span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/>
                <line x1="20" y1="4" x2="8.12" y2="15.88"/>
                <line x1="14.47" y1="14.48" x2="20" y2="20"/>
                <line x1="8.12" y1="8.12" x2="12" y2="12"/>
              </svg>
              <span class="tg-upsell-modal__scissors-line"></span>
            </div>

            <!-- CTA selection -->
            <div class="tg-upsell-modal__selection">
              <label class="tg-upsell-option tg-upsell-option--primary">
                <input type="radio" name="upsell-choice" value="upgrade" data-upsell-radio="upgrade" {% if sale_active %}checked{% endif %} class="tg-upsell-option__input">
                <span class="tg-upsell-option__label">{{ section.settings.upsell_upgrade_label | default: 'YES! Upgrade my order' }}</span>
              </label>
              <label class="tg-upsell-option tg-upsell-option--secondary">
                <input type="radio" name="upsell-choice" value="pass" data-upsell-radio="pass" {% unless sale_active %}checked{% endunless %} class="tg-upsell-option__input">
                <span class="tg-upsell-option__label">{{ section.settings.upsell_pass_label | default: 'No, I will pass' }}</span>
              </label>
              <div class="tg-upsell-modal__extra10" data-upsell-extra10-wrapper hidden>
                <label class="tg-upsell-extra10">
                  <input class="tg-upsell-extra10__input" type="checkbox" data-upsell-extra10 checked>
                  <span class="tg-upsell-extra10__copy">
                    <span class="tg-upsell-extra10__title" data-upsell-extra10-title>Use my extra $10 coupon</span>
                    <span class="tg-upsell-extra10__desc" data-upsell-extra10-desc>Apply it if I keep my original plan.</span>
                  </span>
                </label>
              </div>
            </div>

            <p class="tg-upsell-modal__cta-note">{{ section.settings.upsell_footer_text | default: "Don't travel blindly. Get the full stress-free package." }}</p>

          </div><!-- /offer-card -->

          <!-- Checklist card (white) -->
          <div class="tg-upsell-modal__checklist-card">
            <h4 class="tg-upsell-modal__checklist-title">Everything You Get:</h4>
            <ul class="tg-upsell-modal__checklist" aria-label="Benefits">
              <li class="tg-upsell-modal__checklist-item"><span class="tg-upsell-modal__check" aria-hidden="true">✅</span>Guidebook</li>
              <li class="tg-upsell-modal__checklist-item"><span class="tg-upsell-modal__check" aria-hidden="true">✅</span>Video Guide</li>
              <li class="tg-upsell-modal__checklist-item"><span class="tg-upsell-modal__check" aria-hidden="true">✅</span>1000+ Local Foodie Hidden Gems</li>
              <li class="tg-upsell-modal__checklist-item"><span class="tg-upsell-modal__check" aria-hidden="true">✅</span>Offline Viewing</li>
              <li class="tg-upsell-modal__checklist-item"><span class="tg-upsell-modal__check" aria-hidden="true">✅</span>Up to 3 devices</li>
              <li class="tg-upsell-modal__checklist-item"><span class="tg-upsell-modal__check" aria-hidden="true">✅</span>6 months of access</li>
              <li class="tg-upsell-modal__checklist-item"><span class="tg-upsell-modal__check" aria-hidden="true">✅</span>15% Off Experience Tour Coupon</li>
              <li class="tg-upsell-modal__checklist-item"><span class="tg-upsell-modal__check" aria-hidden="true">✅</span>Purple Map — 1,500+ handpicked spots</li>
            </ul>
          </div>

        </div><!-- /scroll -->
      </div><!-- /offer view -->

      <!-- ── Confirm View ── -->
      <div class="tg-upsell-modal__view tg-upsell-modal__confirm" data-upsell-view="confirm" aria-hidden="true">
        <div class="tg-upsell-modal__confirm-inner">
          <h3 class="tg-upsell-modal__confirm-headline">{{ section.settings.upsell_confirm_headline | default: "Are you sure you want to miss this 50% discount?" }}</h3>
          <p class="tg-upsell-modal__confirm-sub">{{ section.settings.upsell_confirm_subtext | default: "This special upgrade offer expires soon, and you may not see this price again." }}</p>
          <div class="tg-upsell-modal__confirm-actions">
            <button type="button" class="tg-cta tg-upsell-modal__confirm-back" data-upsell-confirm-back>{{ section.settings.upsell_confirm_back_label | default: "Wait, add it to my order" }}</button>
            <button type="button" class="tg-upsell-modal__confirm-decline" data-upsell-confirm-decline>{{ section.settings.upsell_confirm_decline_label | default: "No thanks, continue without the upgrade" }}</button>
          </div>
        </div>
      </div>

    </div><!-- /content -->
  </div><!-- /modal -->
{% endif %}

{% if customer %}
  <div class="ob-extension-modal" data-tour-extension-modal hidden>
    <div class="ob-extension-modal__backdrop" data-tour-extension-modal-close></div>
    <div class="ob-extension-modal__card" role="dialog" aria-modal="true" aria-labelledby="TourExtensionModalTitle">
      <div class="ob-extension-modal__header">
        <div class="ob-extension-modal__header-content">
          <h3 class="ob-extension-modal__heading" id="TourExtensionModalTitle" data-tour-extension-modal-title>Extend Access Period</h3>
          <p class="ob-extension-modal__desc" data-tour-extension-modal-desc>Select how many 30-day units you want to add, then proceed to checkout.</p>
        </div>
        <button class="ob-extension-modal__close" type="button" aria-label="Close" data-tour-extension-modal-close>&times;</button>
      </div>
      <div class="ob-extension-modal__body">
        <div id="GuideExtensionRoot" data-customer-id="{{ customer.id }}"></div>
      </div>
    </div>
  </div>
{% endif %}

<script src="{{ 'travel-booking.js' | asset_url }}" defer></script>
<script>
(function() {
  'use strict';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGuideProduct);
  } else {
    initGuideProduct();
  }

  async function initGuideProduct() {
    var releaseReservationHold = null;
    if (window.TravelBookingHelpers && window.TravelBookingHelpers.releaseReservationHold) {
      releaseReservationHold = window.TravelBookingHelpers.releaseReservationHold;
    }
    var maxWait = 50;
    while (!releaseReservationHold && maxWait > 0) {
      await new Promise(function(r) { setTimeout(r, 100); });
      if (window.TravelBookingHelpers && window.TravelBookingHelpers.releaseReservationHold) {
        releaseReservationHold = window.TravelBookingHelpers.releaseReservationHold;
      }
      maxWait--;
    }

    var tourExtModal = document.querySelector('[data-tour-extension-modal]');
    var tourExtModalTitle = tourExtModal && tourExtModal.querySelector('[data-tour-extension-modal-title]');
    var tourExtModalDesc = tourExtModal && tourExtModal.querySelector('[data-tour-extension-modal-desc]');

    function typeToExtLabel(type) {
      if (type === 'BUNDLE') return 'Korea Guide Kit';
      if (type === 'PDF') return 'PDF Guide';
      if (type === 'VIDEO') return 'Video Guide';
      return '';
    }

    function openTourExtensionModal(type, label) {
      if (tourExtModal) tourExtModal.hidden = false;
      if (tourExtModalTitle) tourExtModalTitle.textContent = label ? 'Extend ' + label : 'Extend Access Period';
      if (tourExtModalDesc) tourExtModalDesc.textContent = label
        ? 'Select how many 30-day units you want to add to your ' + label + ', then proceed to checkout.'
        : 'Select how many 30-day units you want to add, then proceed to checkout.';
      document.dispatchEvent(new CustomEvent('guide-extension:select-type', { detail: { type: type } }));
    }

    function closeTourExtensionModal() {
      if (tourExtModal) tourExtModal.hidden = true;
    }

    if (tourExtModal) {
      tourExtModal.querySelectorAll('[data-tour-extension-modal-close]').forEach(function(el) {
        el.addEventListener('click', closeTourExtensionModal);
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && tourExtModal && !tourExtModal.hidden) closeTourExtensionModal();
    });

    // Current contract is strict no-upgrade: any active guide entitlement blocks all base variants.
    // One eligibility result is therefore enough to gate the entire guide-kit section.
    var guideEligibilityState = {
      status: 'idle',
      blocked: false,
      data: null,
      error: null,
      promise: null
    };

    function buildGuideLoginUrl() {
      var returnUrl = window.location.pathname + window.location.search + window.location.hash;
      return '/account/login?return_url=' + encodeURIComponent(returnUrl);
    }

    function fetchGuideEligibilityEnvelope(variantId) {
      var path = '/guide-purchase/eligibility?variantId=' + encodeURIComponent(String(variantId || ''));
      var proxyFetch = window.TravelBookingHelpers && window.TravelBookingHelpers.proxyFetch;
      if (proxyFetch) {
        return proxyFetch(path, { method: 'GET' });
      }

      return fetch('/apps/bta-booking' + path, {
        method: 'GET',
        credentials: 'same-origin',
        headers: {
          'Accept': 'application/json'
        }
      }).then(function(response) {
        return response.json().catch(function(error) {
          throw {
            code: 'PARSE_ERROR',
