    color: #374151;
    text-align: center;
  }

  /* Price */
  .tg-pricing-card__price{
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
    flex-direction: column;
  }
  .tg-pricing-card__amount{
    font-size: clamp(40px, 3.5vw, 52px);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    line-height: 1;
  }
  .tg-pricing-card__price:has([data-guidekit-discounted-price]:not(:empty)) .tg-pricing-card__amount{
    font-size: 20px;
    font-weight: 600;
    text-decoration: line-through;
    color: #9ca3af;
  }
  .tg-pricing-card__discount{
    font-size: clamp(36px, 3.5vw, 48px);
    font-weight: 900;
    color: #16a34a;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .tg-pricing-card__discount-note{
    width: 100%;
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(0,0,0,.55);
    text-align: center;
  }

  /* Pay once */
  .tg-pricing-card__pay-once{
    margin: 0 0 24px;
    font-size: 13px;
    color: #6b7280;
    text-align: center;
  }

  /* Countdown inside card */
  .tg-pricing-card__countdown-placeholder{
    margin: 0 0 24px;
    padding: 14px 20px;
  }
  .tg-pricing-card__countdown-wrap{
    margin: 0 0 24px;
    padding: 14px 20px;
    background: linear-gradient(135deg, #1e1b4b 0%, #4c1d95 100%);
    border-radius: 14px;
    text-align: center;
  }
  .tg-pricing-card__countdown-num{
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    color: #fff;
    letter-spacing: .06em;
    font-variant-numeric: tabular-nums;
  }

  /* CTA button */
  .tg-pricing-card__btn{
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 15px 24px;
    border-radius: 12px;
    background: #4c1d95;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.01em;
    transition: background 0.2s ease, transform 0.15s ease;
    border: 0;
    cursor: pointer;
    margin-top: auto;
  }
  .tg-pricing-card--featured .tg-pricing-card__btn{
    background: linear-gradient(135deg, #7c3aed, #4c1d95);
    box-shadow: 0 6px 20px rgba(124,58,237,.35);
  }
  .tg-pricing-card__btn:hover{
    background: #3b1575;
    transform: translateY(-1px);
    color: #fff;
  }
  .tg-pricing-card--featured .tg-pricing-card__btn:hover{
    background: linear-gradient(135deg, #6d28d9, #3b1575);
  }
  .tg-pricing-card__btn--extension{
    background: var(--tg-primary);
    color: #fff;
    border: 1px solid transparent;
  }
  .tg-pricing-card__btn--extension:hover{
    opacity: 1;
    background: rgba(91,43,216,.85);
    transform: none;
  }
  .tg-pricing-card__btn--disabled,
  .tg-pricing-card__btn[disabled]{
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
  }
  .tg-pricing-card__eligibility{
    margin: 12px 0 0;
    font-size: 12px;
    line-height: 1.55;
    color: #6b7280;
    text-align: center;
  }

  /* Comparison grid */
  .tg-compare{
    margin-top: 52px;
  }
  .tg-compare__grid{
    display: grid;
    grid-template-columns: 1fr 1.12fr 1fr;
    gap: 20px;
    align-items: start;
  }
  .tg-compare__col{
    background: #fff;
    border-radius: 20px;
    border: 1.5px solid rgba(0,0,0,.08);
    box-shadow: 0 4px 16px rgba(0,0,0,.07);
    overflow: hidden;
  }
  .tg-compare__col--featured{
    border: 2px solid #7c3aed;
    box-shadow: 0 8px 32px rgba(124,58,237,.18);
  }
