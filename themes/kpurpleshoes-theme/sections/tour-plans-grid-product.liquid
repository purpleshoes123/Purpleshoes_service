  .tg-upsell-modal__timer-num{ font-size:18px; font-weight:800; line-height:1; color:#f87171; letter-spacing:.02em; }
  .tg-upsell-modal__timer-unit{ font-size:9px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:rgba(255,255,255,.5); margin-top:3px; }

  /* Price block */
  .tg-upsell-modal__price-block{ text-align:center; margin-bottom:14px; }
