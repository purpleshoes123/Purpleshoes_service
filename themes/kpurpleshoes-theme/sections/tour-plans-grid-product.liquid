    padding: 28px 24px 32px;
    transition: box-shadow 0.2s ease;
  }
  .tg-pricing-card:hover{
    box-shadow: 0 8px 28px rgba(0,0,0,.1);
  }
  .tg-pricing-card--featured{
    border: 2px solid #7c3aed;
    box-shadow: 0 8px 32px rgba(124,58,237,.18);
  }
  .tg-pricing-card--featured:hover{
    box-shadow: 0 14px 48px rgba(124,58,237,.24);
  }

  /* Badge row */
  .tg-pricing-card__badge-row{
    min-height: 28px;
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
  }
  .tg-pricing-card__bar{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(90deg, #7c3aed, #6d28d9);
