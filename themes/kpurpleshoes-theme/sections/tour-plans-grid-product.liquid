      if (expiredEl) { expiredEl.style.display = 'none'; expiredEl.setAttribute('aria-hidden', 'true'); }
      if (timerWrap) timerWrap.style.display = '';
      if (primaryOption) { primaryOption.disabled = false; primaryOption.closest('label').classList.remove('tg-upsell-option--disabled'); }
      if (passOption) passOption.disabled = false;
    }

    function resolveGuide50ExpiryMs(guide50) {
      if (!guide50 || typeof guide50 !== 'object') return null;
      if (guide50.expiresAt) {
        var expiresAtMs = new Date(guide50.expiresAt).getTime();
        if (!isNaN(expiresAtMs)) return expiresAtMs;
      }
      if (typeof guide50.ttlSeconds === 'number' && guide50.ttlSeconds > 0) {
        return Date.now() + (guide50.ttlSeconds * 1000);
      }
      return null;
    }

    function isGuide50AvailableNow(guide50, expiryMs) {
      if (!guide50 || guide50.available !== true) return false;
      if (typeof expiryMs === 'number' && expiryMs <= Date.now()) return false;
      return true;
    }

    function getGuide50CountdownRemainingSeconds() {
      if (!guide50CouponState.available || typeof guide50CouponState.expiresAtMs !== 'number') return 0;
      return Math.max(0, Math.floor((guide50CouponState.expiresAtMs - Date.now()) / 1000));
    }

    function hasActiveGuide50Countdown() {
      return getGuide50CountdownRemainingSeconds() > 0;
    }

    function clearFeaturedCountdownIntervals() {
      featuredCountdownIntervalIds.forEach(function(intervalId) {
        clearInterval(intervalId);
      });
      featuredCountdownIntervalIds = [];
    }

    function hideFeaturedCountdowns() {
      featuredCountdowns.forEach(function(node) {
        node.hidden = true;
        node.setAttribute('aria-hidden', 'true');
      });
      document.querySelectorAll('[data-guidekit-countdown-placeholder]').forEach(function(el) {
        el.hidden = true;
      });
    }

    function clearGuideDiscountDisplays() {
      document.querySelectorAll('[data-guidekit-discounted-price]').forEach(function(node) {
        node.textContent = '';
        node.style.display = 'none';
      });
      document.querySelectorAll('[data-guidekit-discount-note], [data-guidekit-modal-discount-note]').forEach(function(node) {
        setDiscountNote(node, '');
      });

      var modalDisc = document.querySelector('[data-guidekit-modal-discounted-price]');
      if (modalDisc) {
        modalDisc.textContent = '';
        modalDisc.style.display = 'none';
      }
    }

    function syncUpsellCountdownVisibility(modal) {
      if (!modal) return;
      var bar = modal.querySelector('[data-upsell-countdown-bar]');
      if (!bar) return;
      bar.style.display = hasActiveGuide50Countdown() ? '' : 'none';
    }

    function syncUpsellDiscountCopy(modal) {
      if (!modal) return;

      var hasGuide50 = guide50CouponState.available === true;
      var confirmHeadline = modal.querySelector('.tg-upsell-modal__confirm-headline');
      var confirmSubtext = modal.querySelector('.tg-upsell-modal__confirm-sub');

      if (confirmHeadline) {
        confirmHeadline.textContent = hasGuide50 ? upsellDiscountCopy.confirmHeadline : upsellDiscountCopy.neutralConfirmHeadline;
      }
      if (confirmSubtext) {
        confirmSubtext.textContent = hasGuide50 ? upsellDiscountCopy.confirmSubtext : upsellDiscountCopy.neutralConfirmSubtext;
      }
    }

    function startUpsellCountdown(modal) {
      if (upsellTimerIntervalId) {
        clearInterval(upsellTimerIntervalId);
        upsellTimerIntervalId = null;
      }
      if (!hasActiveGuide50Countdown()) {
        syncUpsellCountdownVisibility(modal);
        return;
      }
      var remaining = getGuide50CountdownRemainingSeconds();
      var hEl = modal.querySelector('[data-upsell-timer-h]');
      var mEl = modal.querySelector('[data-upsell-timer-m]');
      var sEl = modal.querySelector('[data-upsell-timer-s]');
      var bar = modal.querySelector('[data-upsell-countdown-bar]');
      var headline = modal.querySelector('[data-upsell-countdown-headline]');
      var expiredEl = modal.querySelector('[data-upsell-countdown-expired]');
      var timerWrap = modal.querySelector('[data-upsell-timer]');
      var primaryOption = modal.querySelector('[data-upsell-radio="upgrade"]');
      var primaryLabel = primaryOption ? primaryOption.closest('label') : null;
      var passOption = modal.querySelector('[data-upsell-radio="pass"]');

      function pad2(n) { return String(n).padStart(2, '0'); }
      function render() {
        var h = Math.floor(remaining / 3600);
        var m = Math.floor((remaining % 3600) / 60);
        var s = remaining % 60;
        if (hEl) hEl.textContent = pad2(h);
        if (mEl) mEl.textContent = pad2(m);
        if (sEl) sEl.textContent = pad2(s);
      }
      function setExpired() {
        if (upsellTimerIntervalId) { clearInterval(upsellTimerIntervalId); upsellTimerIntervalId = null; }
        if (bar) bar.classList.add('tg-upsell-modal__countdown-bar--expired');
        if (headline) headline.style.display = 'none';
        if (expiredEl) { expiredEl.style.display = ''; expiredEl.setAttribute('aria-hidden', 'false'); }
        if (timerWrap) timerWrap.style.display = 'none';
        if (primaryOption) { primaryOption.disabled = true; primaryOption.checked = false; }
        if (primaryLabel) primaryLabel.classList.add('tg-upsell-option--disabled');
        if (passOption) { passOption.checked = true; passOption.disabled = false; }
      }
      render();
      if (remaining <= 0) { setExpired(); return; }
      upsellTimerIntervalId = setInterval(function() {
        if (typeof guide50CouponState.expiresAtMs === 'number') {
          remaining = Math.max(0, Math.floor((guide50CouponState.expiresAtMs - Date.now()) / 1000));
        } else {
          remaining--;
        }
        if (remaining <= 0) { setExpired(); return; }
        render();
      }, 1000);
    }

    var checkoutButtons = document.querySelectorAll('[data-guide-checkout]');
    var featuredCountdowns = document.querySelectorAll('[data-guidekit-countdown]');

    function startFeaturedCountdowns() {
      if (!featuredCountdowns.length) return;
      clearFeaturedCountdownIntervals();
      hideFeaturedCountdowns();
      if (!hasActiveGuide50Countdown()) return;

      featuredCountdowns.forEach(function(node) {
        var textEl = node.querySelector('[data-guidekit-countdown-text]');
        var hoursEl = node.querySelector('[data-guidekit-countdown-hours]');
        var minutesEl = node.querySelector('[data-guidekit-countdown-minutes]');
        var secondsEl = node.querySelector('[data-guidekit-countdown-seconds]');
        if (!textEl && !(hoursEl && minutesEl && secondsEl)) return;

        node.hidden = false;
        node.setAttribute('aria-hidden', 'false');
        document.querySelectorAll('[data-guidekit-countdown-placeholder]').forEach(function(el) {
          el.hidden = false;
        });

        function render() {
          var remaining = getGuide50CountdownRemainingSeconds();
          if (remaining <= 0) {
            node.hidden = true;
            node.setAttribute('aria-hidden', 'true');
            document.querySelectorAll('[data-guidekit-countdown-placeholder]').forEach(function(el) {
              el.hidden = true;
            });
            guide50CouponState.available = false;
            if (guideDiscountState.guide50) {
              guideDiscountState.guide50 = Object.assign({}, guideDiscountState.guide50, { available: false });
            }
            clearFeaturedCountdownIntervals();
            syncGuideDiscountDisplays();
            syncUpsellDiscountCopy(document.getElementById('tg-upsell-modal'));
            syncUpsellCountdownVisibility(document.getElementById('tg-upsell-modal'));
            return;
          }
          var hours = Math.floor(remaining / 3600);
          var minutes = Math.floor((remaining % 3600) / 60);
          var seconds = remaining % 60;
          if (textEl) {
            textEl.textContent = String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
          }
          if (hoursEl && minutesEl && secondsEl) {
            hoursEl.textContent = String(hours).padStart(2, '0');
            minutesEl.textContent = String(minutes).padStart(2, '0');
            secondsEl.textContent = String(seconds).padStart(2, '0');
          }
        }

        render();
        featuredCountdownIntervalIds.push(setInterval(function() {
          render();
        }, 1000));
      });
    }
    checkoutButtons.forEach(function(btn) {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        var variantId = this.getAttribute('data-variant-id');
        var isFeatured = this.getAttribute('data-is-featured') === 'true';
        var upsellEnabled = {{ section.settings.upsell_enabled | json }};

        if (!window.__customerId) {
          window.location.href = buildGuideLoginUrl();
          return;
        }

        try {
          var eligibility = await ensureGuideEligibility(variantId);
          if (eligibility && eligibility.canPurchaseBase === false) {
            var firstEnt = eligibility.activeEntitlements && eligibility.activeEntitlements[0];
            var extType = firstEnt ? String(firstEnt.type || '') : '';
            openTourExtensionModal(extType, typeToExtLabel(extType));
            return;
          }
        } catch (error) {
          if (error && error.code === 'AUTH_LOGIN_REQUIRED') {
            window.location.href = buildGuideLoginUrl();
            return;
          }
          alert(messageForGuideEligibilityError(error));
          return;
        }

        if (isFeatured) {
          executeCheckoutFlow(variantId, this, { useExtra10: true });
          return;
        }
        if (!upsellEnabled) {
          executeCheckoutFlow(variantId, this, { useExtra10: false });
          return;
        }
        openUpsellModal(variantId, this);
      });
    });

    if (window.__customerId && checkoutButtons.length > 0) {
      ensureGuideEligibility(checkoutButtons[0].getAttribute('data-variant-id')).catch(function(error) {
        console.warn('[Guide Product] Eligibility precheck failed:', error);
      });
    }

    startFeaturedCountdowns();

    var modal = document.getElementById('tg-upsell-modal');
    if (modal) {
      syncUpsellDiscountCopy(modal);
      syncUpsellCountdownVisibility(modal);
      var closeBtn = modal.querySelector('.tg-upsell-modal__close');
      var overlay = modal.querySelector('.tg-upsell-modal__overlay');
      if (closeBtn) closeBtn.addEventListener('click', closeUpsellModal);
      if (overlay) overlay.addEventListener('click', closeUpsellModal);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') {
          var confirmView = modal.querySelector('[data-upsell-view="confirm"]');
          if (confirmView && confirmView.classList.contains('tg-upsell-modal__view--active')) {
            showUpsellView(modal, 'offer');
            modal.querySelector('[data-upsell-radio="upgrade"]').checked = true;
          } else {
            closeUpsellModal();
          }
        }
      });
      var declineOption = modal.querySelector('.tg-upsell-option--secondary');
      if (declineOption) {
        declineOption.addEventListener('click', function(e) {
          e.preventDefault();
          var passRadio = modal.querySelector('[data-upsell-radio="pass"]');
          if (passRadio) passRadio.checked = true;
          showUpsellView(modal, 'confirm');
        });
      }
      var confirmBack = modal.querySelector('[data-upsell-confirm-back]');
      if (confirmBack) {
        confirmBack.addEventListener('click', function() {
          showUpsellView(modal, 'offer');
          var up = modal.querySelector('[data-upsell-radio="upgrade"]');
          if (up) up.checked = true;
        });
      }
      var confirmDecline = modal.querySelector('[data-upsell-confirm-decline]');
      if (confirmDecline) {
        confirmDecline.addEventListener('click', async function() {
          var originalVariantId = modal.getAttribute('data-original-variant-id');
          var originalButtonId = modal.getAttribute('data-original-button-id');
          var originalButton = originalButtonId ? document.querySelector('[data-upsell-button-id="' + originalButtonId + '"]') : null;
          var useExtra10 = isUpsellExtra10Selected(modal);
          closeUpsellModal();
          await executeCheckoutFlow(originalVariantId, originalButton, { useExtra10: useExtra10 });
        });
      }
      var isUpsellSubmitting = false;
      async function proceedUpsellSelection() {
        if (isUpsellSubmitting) return;
        var selected = modal.querySelector('input[name="upsell-choice"]:checked');
        if (!selected) { alert('Please select an option'); return; }
        isUpsellSubmitting = true;
        try {
          var originalVariantId = modal.getAttribute('data-original-variant-id');
          var originalButtonId = modal.getAttribute('data-original-button-id');
          var featuredVariantId = modal.getAttribute('data-featured-variant-id');
          var targetVariantId = selected.value === 'upgrade' ? featuredVariantId : originalVariantId;
          var originalButton = originalButtonId ? document.querySelector('[data-upsell-button-id="' + originalButtonId + '"]') : null;
          var useExtra10 = selected.value === 'upgrade' ? true : isUpsellExtra10Selected(modal);
          if (selected.value === 'upgrade' && typeof gtag === 'function') {
            gtag('event', 'upsell_upgrade_accepted', {
              event_category: 'purchase_flow',
              original_variant_id: originalVariantId,
              upgraded_to_variant_id: featuredVariantId
            });
          }
          closeUpsellModal();
          await executeCheckoutFlow(targetVariantId, originalButton, { useExtra10: useExtra10 });
        } finally {
          isUpsellSubmitting = false;
        }
      }

      var continueBtn = modal.querySelector('[data-upsell-continue]');
      if (continueBtn) {
        continueBtn.addEventListener('click', function() {
          proceedUpsellSelection();
        });
      }
      var extra10Input = getUpsellExtra10Input(modal);
      var extra10Wrapper = modal.querySelector('[data-upsell-extra10-wrapper]');
      if (extra10Input) {
        extra10Input.addEventListener('change', function() {
          if (extra10Wrapper) extra10Wrapper.setAttribute('data-extra10-touched', 'true');
          syncGuideDiscountDisplays();
        });
      }

      var primaryUpsellOption = modal.querySelector('.tg-upsell-option--primary');
      if (primaryUpsellOption) {
        primaryUpsellOption.addEventListener('click', function(e) {
          var upgradeRadio = modal.querySelector('[data-upsell-radio="upgrade"]');
          if (upgradeRadio && upgradeRadio.disabled) return;
          if (e.target && e.target.closest('input[type="radio"]')) return;
          if (upgradeRadio) upgradeRadio.checked = true;
          proceedUpsellSelection();
        });
      }

      var saleHeader = modal.querySelector('[data-sale-header]');
      var timer = modal.querySelector('[data-countdown-timer]');
      var endsAt = {{ section.settings.upsell_sale_ends_at | json }};
      if (saleHeader && timer && endsAt) {
        var endTime = new Date(endsAt).getTime();
        if (!isNaN(endTime) && endTime > Date.now()) {
          function updateSaleTimer() {
            var diff = endTime - Date.now();
            if (diff <= 0) {
              saleHeader.style.display = 'none';
              var up = modal.querySelector('[data-upsell-radio="upgrade"]');
              var pass = modal.querySelector('[data-upsell-radio="pass"]');
              if (up && pass) { up.checked = false; pass.checked = true; }
              return;
            }
            var hours = Math.floor(diff / 3600000);
            var minutes = Math.floor((diff % 3600000) / 60000);
            var seconds = Math.floor((diff % 60000) / 1000);
            var hEl = modal.querySelector('[data-timer-hours]');
            var mEl = modal.querySelector('[data-timer-minutes]');
            var sEl = modal.querySelector('[data-timer-seconds]');
            if (hEl) hEl.textContent = String(hours).padStart(2, '0');
            if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
            if (sEl) sEl.textContent = String(seconds).padStart(2, '0');
          }
          updateSaleTimer();
          setInterval(updateSaleTimer, 1000);
        } else {
          saleHeader.style.display = 'none';
        }
      }
    }

    if (window.__customerId) {
      try {
        var proxyFetch = window.TravelBookingHelpers && window.TravelBookingHelpers.proxyFetch;
        if (window.psWelcomeOfferReady) await window.psWelcomeOfferReady;
        var summary = proxyFetch ? await proxyFetch('/coupons/summary', { method: 'GET' }) : await fetch('/apps/bta-booking/coupons/summary', { method: 'GET' }).then(function(r) { return r.ok ? r.json() : Promise.reject(new Error('summary failed')); });
        var data = summary && (summary.data !== undefined ? summary.data : summary);
        var guide50 = data && data.coupons && data.coupons.guide50;
        var extra10 = data && data.coupons && data.coupons.extra10;
        var currency = (data && data.currency) || 'USD';
        var guide50ExpiryMs = resolveGuide50ExpiryMs(guide50);
        var guide50Available = isGuide50AvailableNow(guide50, guide50ExpiryMs);
        var guide50ForDisplay = guide50 ? Object.assign({}, guide50, { available: guide50Available }) : guide50;
        guideDiscountState.guide50 = guide50ForDisplay;
        guideDiscountState.extra10 = extra10;
        guideDiscountState.currency = currency;
        guide50CouponState.available = guide50Available;
        guide50CouponState.expiresAtMs = guide50ExpiryMs;
        extra10CouponState.available = !!(extra10 && extra10.available === true);
        extra10CouponState.amountCents = resolveExtra10AmountCents(extra10);
        startFeaturedCountdowns();
        var upsellModal = document.getElementById('tg-upsell-modal');
        if (upsellModal) {
          syncUpsellDiscountCopy(upsellModal);
          syncUpsellCountdownVisibility(upsellModal);
          if (upsellModal.style.display === 'flex' && hasActiveGuide50Countdown()) {
            resetUpsellCountdown(upsellModal);
            startUpsellCountdown(upsellModal);
          }
        }
        syncGuideDiscountDisplays();
      } catch (e) {
        console.warn('[Guide Product] Coupon summary failed:', e);
      }
    }
  }
})();
</script>

<style>
