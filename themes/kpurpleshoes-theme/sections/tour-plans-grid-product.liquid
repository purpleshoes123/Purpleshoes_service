    background: linear-gradient(90deg, #8b5cf6, #7c3aed);
  }
  .tg-pricing-card__bar--ghost{
    visibility: hidden;
  }

  /* Plan name */
  .tg-pricing-card__plan{
    margin: 0 0 16px;
    font-size: 15px;
