    function summarizeActiveTypes(entitlements) {
      var seen = {};
      var types = [];
      if (!Array.isArray(entitlements)) return types;

      entitlements.forEach(function(item) {
        var type = item && item.type ? String(item.type) : '';
        if (!type || seen[type]) return;
        seen[type] = true;
        types.push(type);
      });
      return types;
    }

