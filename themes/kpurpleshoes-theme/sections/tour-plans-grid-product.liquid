    function resolveGuideEligibilityData(envelope) {
      return envelope && typeof envelope === 'object' && 'data' in envelope ? envelope.data : envelope;
    }

    function ensureGuideEligibility(variantId, options) {
      options = options || {};

      if (!window.__customerId) {
        return Promise.resolve(null);
      }

      if (!options.force) {
        if (guideEligibilityState.data) {
          return Promise.resolve(guideEligibilityState.data);
        }
        if (guideEligibilityState.promise) {
          return guideEligibilityState.promise;
        }
      }

      guideEligibilityState.status = 'loading';
      guideEligibilityState.error = null;
      setGuideButtonsChecking(true);

      guideEligibilityState.promise = fetchGuideEligibilityEnvelope(variantId)
        .then(function(envelope) {
          var data = resolveGuideEligibilityData(envelope);
          guideEligibilityState.status = 'loaded';
          guideEligibilityState.data = data;
          guideEligibilityState.error = null;

          if (data && data.canPurchaseBase === false) {
            applyGuideEligibilityBlock(data);
          } else {
            clearGuideEligibilityBlock();
          }

          return data;
        })
        .catch(function(error) {
          var normalized = normalizeGuideEligibilityError(error);
          guideEligibilityState.status = 'error';
          guideEligibilityState.data = null;
          guideEligibilityState.error = normalized;
          clearGuideEligibilityBlock();
          throw normalized;
        })
        .finally(function() {
          guideEligibilityState.promise = null;
        });

      return guideEligibilityState.promise;
    }

    function setCheckoutButtonsLocked(locked, triggerButton) {
