    }

    function formatGuideCouponAmount(cents, currency) {
      if ((currency || 'USD') === 'USD' && cents % 100 === 0) {
        return '$' + String(cents / 100);
      }
      return formatGuideMoney(cents, currency);
    }

    function renderGuideKitDiscountElement(priceCents, discountEl, discountNoteEl, displayContext, currency) {
      if (!discountEl || isNaN(priceCents)) return;
      var discountedCents = calculateGuideKitDiscountedCents(priceCents, displayContext);
      if (displayContext.showDiscount && discountedCents < priceCents && discountedCents >= 0) {
        discountEl.textContent = formatGuideMoney(discountedCents, currency);
        discountEl.style.display = '';
        setDiscountNote(discountNoteEl, displayContext.note);
