    async function executeCheckoutFlow(variantId, button, options) {
      setCheckoutButtonsLocked(true, button);
      try {
        var cartUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/') + 'cart.js';
        var cartRes = await fetch(cartUrl);
        var existingHoldId = null;
        if (cartRes.ok) {
          var cartData = await cartRes.json();
          if (cartData.items && cartData.items.length > 0) {
            for (var i = 0; i < cartData.items.length; i++) {
              var item = cartData.items[i];
              var props = item.properties;
              if (props) {
                var map = Array.isArray(props) ? Object.fromEntries(props.map(function(p) { return [p.name || p.first, p.value || p.last]; })) : props;
                existingHoldId = map.hold_id || map.holdId || null;
                if (existingHoldId) break;
              }
            }
          }
        }
        if (existingHoldId && releaseReservationHold) {
          try {
            await releaseReservationHold(existingHoldId, { productId: null, date: null, clientRequestId: null });
          } catch (err) {
            if (err.message && (err.message.indexOf('로그인') !== -1 || err.message.toLowerCase().indexOf('log in') !== -1)) {
              alert('Please log in to continue.');
              window.location.href = '/account/login?return_url=' + encodeURIComponent(window.location.pathname);
              return;
            }
            alert(err.message || 'Failed to release the reservation hold. Please try again.');
            setCheckoutButtonsLocked(false);
            return;
          }
        }
        var preparedCheckout = await prepareGuideCheckout(variantId, options);
        var themeCartCheckout = window.BtaThemeCartCheckout;
        if (themeCartCheckout && typeof themeCartCheckout.isThemeCartIntent === 'function' && themeCartCheckout.isThemeCartIntent(preparedCheckout.intent)) {
          await themeCartCheckout.runIntent(preparedCheckout.intent);
          return;
        }

        if (preparedCheckout.intent && preparedCheckout.intent.checkoutMode === 'theme_cart') {
          throw {
            code: 'INVALID_RESPONSE',
            message: 'Checkout could not be prepared. Please try again.',
            raw: preparedCheckout.intent
          };
        }

        window.location.href = preparedCheckout.checkoutUrl;
      } catch (err) {
        var normalizedError = normalizeGuideCheckoutError(err);
        console.error('[Guide Product] Checkout flow failed:', normalizedError);
        if (normalizedError.code === 'AUTH_LOGIN_REQUIRED') {
          window.location.href = buildGuideLoginUrl();
          return;
        }
        alert(messageForGuideCheckoutError(normalizedError));
        setCheckoutButtonsLocked(false);
      }
    }

