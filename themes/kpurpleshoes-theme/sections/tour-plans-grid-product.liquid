    async function prepareGuideCheckout(variantId, options) {
      var useExtra10 = !(options && options.useExtra10 === false);
      var themeCartCheckout = window.BtaThemeCartCheckout;
      var preparePath = themeCartCheckout && typeof themeCartCheckout.withCheckoutMode === 'function'
        ? themeCartCheckout.withCheckoutMode('/guide/prepare-checkout')
        : '/guide/prepare-checkout?checkoutMode=theme_cart';
      var envelope = await postGuideProxy(preparePath, {
        variantId: String(variantId),
        quantity: 1,
        useExtra10: useExtra10,
        clientRequestId: createGuideClientRequestId()
      });
      var data = envelope && typeof envelope === 'object' && 'data' in envelope ? envelope.data : envelope || {};
      var checkoutUrl = data.checkoutUrl || data.checkout_url || null;

      if (data.checkoutMode === 'theme_cart') {
        return {
          intent: data,
          checkoutMode: data.checkoutMode,
          decision: data.decision || null,
          appliedCodes: data.appliedCodes || null,
          correlationId: envelope && envelope.meta ? envelope.meta.correlationId : null
        };
      }

      if (!checkoutUrl) {
        throw {
          code: 'INVALID_RESPONSE',
          message: 'No checkout URL was returned.',
          correlationId: envelope && envelope.meta ? envelope.meta.correlationId : null,
          raw: envelope
        };
      }

      return {
        checkoutUrl: checkoutUrl,
        decision: data.decision || null,
        appliedCodes: data.appliedCodes || null,
        correlationId: envelope && envelope.meta ? envelope.meta.correlationId : null
      };
    }

    function resolveExtra10AmountCents(extra10) {
      if (!extra10 || typeof extra10.amount !== 'number' || !isFinite(extra10.amount) || extra10.amount <= 0) {
