    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.3;
  }
  .tg-pricing__sub{
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(0,0,0,.6);
  }
  .tg-pricing__grid{
    display: grid;
    grid-template-columns: 1fr 1.12fr 1fr;
    gap: 20px;
    align-items: stretch;
  }

  /* Card */
  .tg-pricing-card{
    background: #fff;
    border-radius: 20px;
    border: 1.5px solid rgba(0,0,0,.08);
