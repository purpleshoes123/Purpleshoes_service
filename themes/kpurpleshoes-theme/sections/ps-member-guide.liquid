{{ 'member-guide.css' | asset_url | stylesheet_tag }}
<section id="member-purchase" class="tg-pricing ps-member-guide" {% if customer %}data-member-guide{% endif %} tabindex="-1">
  <div class="tg-pricing__inner">
    <header class="tg-pricing__head">
      <h2 class="tg-pricing__title">{{ section.settings.heading | escape }}</h2>
    </header>
    {% if customer %}<p role="status" aria-live="polite" data-member-status>{{ 'member_catalog.loading' | t }}</p>{% endif %}
    <div class="tg-pricing__grid" data-member-plans role="list">
      {% for block in section.blocks %}
        <article class="tg-pricing-card{% if block.settings.kind == 'BUNDLE' %} tg-pricing-card--featured{% endif %}" data-plan-kind="{{ block.settings.kind | escape }}" {% if customer %}data-plan-cta="{{ block.settings.cta | escape }}"{% endif %} role="listitem" {{ block.shopify_attributes }}>
          {% if customer %}
            {% if block.settings.kind == 'BUNDLE' %}<div class="tg-pricing-card__badge-row"><span class="tg-pricing-card__bar">{{ block.settings.badge | escape }}</span></div>{% endif %}
          {% endif %}
          <h3 class="tg-pricing-card__plan">{{ block.settings.title | escape }}</h3>
          {% if customer %}
            <div data-plan-purchase></div>
          {% else %}
            {% assign guide_return = request.path | append: '#member-purchase' | url_encode %}
            <a class="tg-pricing-card__btn" href="/customer_authentication/login?return_to={{ guide_return }}">{{ 'member_catalog.signin' | t }}</a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
    {% if customer %}
    <dialog class="ps-member-guide__upgrade" data-member-extension aria-labelledby="MemberExtension-{{ section.id }}">
      <button type="button" class="ps-member-guide__close" data-extension-close aria-label="{{ 'member_catalog.close' | t }}">×</button>
      <h2 id="MemberExtension-{{ section.id }}">{{ 'member_catalog.extend_title' | t }}</h2>
      <p>{{ 'member_catalog.extend_description' | t }}</p>
      <div id="GuideExtensionRoot" data-customer-id="{{ customer.id }}"></div>
    </dialog>
    <button type="button" class="button" data-member-retry hidden>{{ 'member_catalog.retry' | t }}</button>
    <dialog class="ps-member-guide__upgrade" data-member-upgrade aria-labelledby="MemberUpgrade-{{ section.id }}">
      <button type="button" class="ps-member-guide__close" data-upgrade-close aria-label="{{ 'member_catalog.close' | t }}">×</button>
      <h2 id="MemberUpgrade-{{ section.id }}">{{ 'member_catalog.upgrade_title' | t }}</h2>
      <p>{{ 'member_catalog.upgrade_description' | t }}</p>
      <strong data-upgrade-price></strong>
      <p data-upgrade-savings></p>
      <p>{{ 'member_catalog.estimate' | t }}</p>
      <div data-only-coupon hidden>
        <label><input type="checkbox" data-only-extra checked><span>{{ 'member_catalog.only_coupon' | t }}</span></label>
        <p data-only-total></p>
      </div>
      <button type="button" class="button" data-upgrade-accept>{{ 'member_catalog.upgrade_accept' | t }}</button>
      <button type="button" class="button button--secondary" data-upgrade-keep>{{ 'member_catalog.upgrade_keep' | t }}</button>
    </dialog>
    <script type="application/json" data-member-copy>{
      "error": {{ 'member_catalog.error' | t | json }},
      "loading": {{ 'member_catalog.loading' | t | json }},
      "checkout": {{ 'member_catalog.checkout' | t | json }},
      "working": {{ 'member_catalog.working' | t | json }},
      "extra": {{ 'member_catalog.extra' | t | json }},
      "estimate": {{ 'member_catalog.estimate' | t | json }},
      "active": {{ 'member_catalog.active' | t | json }},
      "active_hint": {{ 'member_catalog.active_hint' | t | json }},
      "extend": {{ 'member_catalog.extend' | t | json }},
      "extend_access": {{ 'member_catalog.extend_access' | t | json }},
      "extend_hint": {{ 'member_catalog.extend_hint' | t | json }},
      "extend_price": {{ 'member_catalog.extend_price' | t | json }},
      "only_coupon_hint": {{ 'member_catalog.only_coupon_hint' | t | json }},
      "only_total": {{ 'member_catalog.only_total' | t: amount: '[amount]' | json }},
      "kit_percent_extra": {{ 'member_catalog.kit_percent_extra' | t: percent: '[percent]', amount: '[amount]' | json }},
      "kit_percent": {{ 'member_catalog.kit_percent' | t: percent: '[percent]' | json }},
      "kit_extra": {{ 'member_catalog.kit_extra' | t: amount: '[amount]' | json }},
      "pay_once": {{ 'member_catalog.pay_once' | t | json }},
      "welcome_timer": {{ 'member_catalog.welcome_timer' | t: percent: '[percent]' | json }},
      "features": {
        "PDF": [{{ 'member_catalog.pdf' | t | json }}, {{ 'member_catalog.single_access' | t | json }}, {{ 'member_catalog.offline' | t | json }}],
        "VIDEO": [{{ 'member_catalog.video' | t | json }}, {{ 'member_catalog.single_access' | t | json }}, {{ 'member_catalog.offline' | t | json }}],
        "BUNDLE": [{{ 'member_catalog.bundle_contents' | t | json }}, {{ 'member_catalog.bundle_access' | t | json }}, {{ 'member_catalog.map' | t | json }}, {{ 'member_catalog.tour_coupon' | t | json }}, {{ 'member_catalog.offline' | t | json }}]
      },
      "PDF": {{ 'member_catalog.pdf' | t | json }},
      "BUNDLE": {{ 'member_catalog.bundle' | t | json }},
      "VIDEO": {{ 'member_catalog.video' | t | json }}
    }</script>

    {% endif %}
      <div class="tg-compare" aria-label="Plan comparison">
        <div class="tg-compare__grid">

          <div class="tg-compare__col">
            <div class="tg-compare__col-head">Guidebook ONLY</div>
            <ul class="tg-compare__list">
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Guidebook</li>
              <li class="tg-compare__item tg-compare__item--no">Video Guide</li>
              <li class="tg-compare__item tg-compare__item--no">1,000+ Local Foodie Hidden Gems</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Offline Viewing</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Up to 2 devices</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>90-days access</li>
              <li class="tg-compare__item tg-compare__item--no">15% Off Experience Tour Coupon</li>
              <li class="tg-compare__item tg-compare__item--no">Purple Map — 1,500+ handpicked spots</li>
            </ul>
          </div>

          <div class="tg-compare__col tg-compare__col--featured">
            <div class="tg-compare__col-head">Korea Guide Kit</div>
            <ul class="tg-compare__list">
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Guidebook</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Video Guide</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>1,000+ Local Foodie Hidden Gems</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Offline Viewing</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Up to 3 devices</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>180-days access</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>15% Off Experience Tour Coupon</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Purple Map — 1,500+ handpicked spots</li>
            </ul>
          </div>

          <div class="tg-compare__col">
            <div class="tg-compare__col-head">Video Guide ONLY</div>
            <ul class="tg-compare__list">
              <li class="tg-compare__item tg-compare__item--no">Guidebook</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Video Guide</li>
              <li class="tg-compare__item tg-compare__item--no">1,000+ Local Foodie Hidden Gems</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Offline Viewing</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>Up to 2 devices</li>
              <li class="tg-compare__item tg-compare__item--yes"><span class="tg-compare__icon" aria-hidden="true">✓</span>90-days access</li>
              <li class="tg-compare__item tg-compare__item--no">15% Off Experience Tour Coupon</li>
              <li class="tg-compare__item tg-compare__item--no">Purple Map — 1,500+ handpicked spots</li>
            </ul>
          </div>

        </div>
      </div>

  </div>
</section>
{% if customer %}
  {{ 'guide-extension.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'guide-extension.js' | asset_url }}" defer></script>
  <script src="{{ 'member-guide.js' | asset_url }}" defer></script>
{% endif %}
{% schema %}
{
  "name":"Member guide plans",
  "settings":[{"type":"text","id":"heading","label":"Heading","default":"Choose Your Korea Guide"}],
  "blocks":[{"type":"plan","name":"Guide plan","limit":3,"settings":[
    {"type":"select","id":"kind","label":"Plan","options":[{"value":"PDF","label":"Guidebook"},{"value":"BUNDLE","label":"Korea Guide Kit"},{"value":"VIDEO","label":"Video guide"}],"default":"PDF"},
    {"type":"text","id":"title","label":"Title"},
    {"type":"textarea","id":"description","label":"Description"},
    {"type":"text","id":"badge","label":"Badge"},
    {"type":"text","id":"cta","label":"Purchase button"}
  ]}],
  "presets":[{"name":"Member guide plans"}]
}
{% endschema %}
