{% schema %}
{"name":"Korea Guide Kit detail","settings":[{"type":"text","id":"heading","label":"Legacy plan heading","default":"Choose Your Korea Guide"},{"type":"image_picker","id":"hero_image","label":"Hero image"}],"blocks":[{"type":"plan","name":"Guide plan","limit":3,"settings":[{"type":"select","id":"kind","label":"Plan","options":[{"value":"PDF","label":"Guidebook"},{"value":"BUNDLE","label":"Korea Guide Kit"},{"value":"VIDEO","label":"Video guide"}],"default":"PDF"},{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"description","label":"Description"},{"type":"text","id":"badge","label":"Badge"},{"type":"text","id":"cta","label":"Purchase button"}]}],"presets":[{"name":"Korea Guide Kit detail"}]}
{% endschema %}