{{ 'kit-detail.css' | asset_url | stylesheet_tag }}
{%- assign kit_hero = section.settings.hero_image | default: images['938207a5477970309a67488f9a0400dc.png'] -%}
{%- assign guide_return = request.path | append: '#member-purchase' | url_encode -%}
<div class="kgd" data-kit-detail {% if customer %}data-member-guide data-kit-state="loading"{% else %}data-kit-state="guest"{% endif %}>
  <div class="kgd__inner">
    <section class="kgd__hero" aria-labelledby="KitHero-{{ section.id }}">
      {% if kit_hero != blank %}{{ kit_hero | image_url: width: 1800 | image_tag: class: 'kgd__hero-image', widths: '600, 900, 1200, 1800', sizes: '(min-width: 1280px) 1200px, 100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}{% endif %}
      <div class="kgd__hero-copy"><p class="kgd__eyebrow">{{ 'kit_detail.eyebrow' | t }}</p><h1 id="KitHero-{{ section.id }}">{{ 'kit_detail.hero_title' | t }}</h1><p class="kgd__hero-lead">{{ 'kit_detail.hero_lead' | t }}</p><p>{{ 'kit_detail.hero_copy' | t }}</p></div>
    </section>
    <div data-member-plans>
      <section id="member-purchase" class="kgd__panel kgd__included" tabindex="-1" aria-labelledby="KitIncluded-{{ section.id }}">
        <div class="kgd__contents"><h2 id="KitIncluded-{{ section.id }}">{{ 'kit_detail.included' | t }}</h2>
          <div class="kgd__screens">
            <figure><figcaption>{{ 'kit_detail.map' | t }}</figcaption><img src="{{ 'signup-preview-map.png' | asset_url }}" alt="{{ 'kit_detail.map_alt' | t }}" width="1912" height="910" loading="lazy" class="kgd__map-image"></figure>
            <figure><figcaption>{{ 'kit_detail.book' | t }}</figcaption><img src="{{ 'signup-preview-guidebook.png' | asset_url }}" alt="{{ 'kit_detail.book_alt' | t }}" width="1903" height="832" loading="lazy" class="kgd__book-image"></figure>
            <figure><figcaption>{{ 'kit_detail.video' | t }}</figcaption><img src="{{ 'signup-preview-video.png' | asset_url }}" alt="{{ 'kit_detail.video_alt' | t }}" width="1914" height="909" loading="lazy" class="kgd__video-image"></figure>
          </div>
          <p class="kgd__contents-note">{% render 'starter-kit-icon', name: 'book' %}<strong>{{ 'kit_detail.contents' | t }}</strong></p><p class="kgd__contents-note kgd__muted">{% render 'starter-kit-icon', name: 'clipboard' %}{{ 'kit_detail.access' | t }}</p>
        </div>
        <aside class="kgd__price-card" data-plan-kind="BUNDLE">
          {% if customer %}
          <div data-plan-purchase></div><p data-member-status class="kgd__status" role="status" aria-live="polite">{{ 'kit_detail.loading' | t }}</p><button class="kgd__button kgd__button--outline" data-member-retry type="button" hidden>{{ 'kit_detail.retry' | t }}</button>
          {% else %}
          <p class="kgd__muted">{{ 'kit_detail.guest_offer' | t }}</p><p class="kgd__amount">USD 75</p><strong class="kgd__condition">{{ 'kit_detail.guest_condition' | t }}</strong><p class="kgd__regular">{{ 'kit_detail.regular_kit' | t }}</p><p class="kgd__validity">{{ 'kit_detail.validity' | t }}</p><a class="kgd__button" href="/customer_authentication/login?return_to={{ guide_return }}">{{ 'kit_detail.signin' | t }}</a><p class="kgd__guest-note">{{ 'kit_detail.guest_note' | t }}</p>
          {% endif %}
        </aside>
      </section>
      <section class="kgd__panel kgd__map" aria-labelledby="KitMap-{{ section.id }}">
        <div><h2 id="KitMap-{{ section.id }}">{{ 'kit_detail.map_title' | t }}</h2>
          <div class="kgd__map-point"><span>{% render 'starter-kit-icon', name: 'navigation' %}</span><div><h3>{{ 'kit_detail.interest' | t }}</h3><p>{{ 'kit_detail.interest_copy' | t }}</p></div></div>
          <div class="kgd__map-point"><span>{% render 'starter-kit-icon', name: 'pin' %}</span><div><h3>{{ 'kit_detail.beyond' | t }}</h3><p>{{ 'kit_detail.beyond_copy' | t }}</p></div></div>
          <div class="kgd__map-point"><span>{% render 'starter-kit-icon', name: 'map' %}</span><div><h3>{{ 'kit_detail.directions' | t }}</h3><p>{{ 'kit_detail.directions_copy' | t }}</p></div></div>
        </div>
        <figure class="kgd__demo"><div class="kgd__video-frame"><video data-kit-demo controls playsinline preload="none" poster="{{ 'purple-map-demo-poster.jpg' | asset_url }}" aria-label="{{ 'kit_detail.watch' | t }}"><source src="{{ 'purple-map-demo.mp4' | asset_url }}" type="video/mp4"></video><button type="button" class="kgd__play" data-kit-play aria-label="{{ 'kit_detail.play' | t }}">{% render 'starter-kit-icon', name: 'play' %}</button></div><figcaption>{{ 'kit_detail.watch' | t }}</figcaption><p data-kit-video-error class="kgd__muted" role="status" hidden>{{ 'kit_detail.video_error' | t }}</p></figure>
        <div class="kgd__trust">{% render 'starter-kit-icon', name: 'heart' %}<p><strong>{{ 'kit_detail.trust_title' | t }}</strong><span>{{ 'kit_detail.trust_copy' | t }}</span></p></div>
      </section>
      <section class="kgd__panel kgd__only" aria-labelledby="KitOnly-{{ section.id }}">
        <div class="kgd__section-head"><h2 id="KitOnly-{{ section.id }}">{{ 'kit_detail.only_title' | t }}</h2><p data-kit-new-only>{{ 'kit_detail.only_note' | t }}</p></div><div class="kgd__only-grid">
        <article class="kgd__only-card" data-plan-kind="PDF"><div class="kgd__only-top"><div class="kgd__only-image"><img src="{{ 'kit-guidebook-cover.png' | asset_url }}" alt="{{ 'kit_detail.cover_alt' | t }}" width="1273" height="1800" loading="lazy" ></div><div><h3>{{ 'kit_detail.PDF' | t }}</h3><p class="kgd__muted" data-kit-only-regular>{{ 'kit_detail.regular' | t }}</p><strong class="kgd__only-price" data-only-price>USD 50</strong><p class="kgd__muted">{{ 'kit_detail.pdf_copy' | t }}</p></div></div><div class="kgd__only-bottom"><p>{% render 'starter-kit-icon', name: 'clipboard' %}<span data-only-access>{{ 'kit_detail.only_access' | t }}</span><br>{% render 'starter-kit-icon', name: 'map' %}{{ 'kit_detail.no_map' | t }}</p>{% if customer %}<div data-plan-purchase></div>{% endif %}</div></article>
        <article class="kgd__only-card" data-plan-kind="VIDEO"><div class="kgd__only-top"><div class="kgd__only-image"><img src="{{ 'signup-preview-video.png' | asset_url }}" alt="{{ 'kit_detail.video_alt' | t }}" width="1914" height="909" loading="lazy" ><span class="kgd__thumbnail-play" aria-hidden="true">{% render 'starter-kit-icon', name: 'play' %}</span></div><div><h3>{{ 'kit_detail.VIDEO' | t }}</h3><p class="kgd__muted" data-kit-only-regular>{{ 'kit_detail.regular' | t }}</p><strong class="kgd__only-price" data-only-price>USD 100</strong><p class="kgd__muted">{{ 'kit_detail.video_copy' | t }}</p></div></div><div class="kgd__only-bottom"><p>{% render 'starter-kit-icon', name: 'clipboard' %}<span data-only-access>{{ 'kit_detail.only_access' | t }}</span><br>{% render 'starter-kit-icon', name: 'map' %}{{ 'kit_detail.no_map' | t }}</p>{% if customer %}<div data-plan-purchase></div>{% endif %}</div></article>
      </div></section>
    </div>
    <section class="kgd__panel kgd__steps"><h2 data-kit-steps-heading>{{ 'kit_detail.steps_title' | t }}</h2><div class="kgd__step-grid">
      <div class="kgd__step"><b>1</b><div><h3 data-kit-step1>{% if customer %}{{ 'kit_detail.member_step' | t }}{% else %}{{ 'kit_detail.guest_step' | t }}{% endif %}</h3><p data-kit-step1-copy>{% if customer %}{{ 'kit_detail.member_step_copy' | t }}{% else %}{{ 'kit_detail.guest_step_copy' | t }}{% endif %}</p></div>{% render 'starter-kit-icon', name: 'chevron' %}</div>
      <div class="kgd__step"><b>2</b><div><h3 data-kit-step2>{{ 'kit_detail.purchase_step' | t }}</h3><p data-kit-step2-copy>{{ 'kit_detail.purchase_step_copy' | t }}</p></div>{% render 'starter-kit-icon', name: 'chevron' %}</div>
      <div class="kgd__step"><b>3</b><div><h3 data-kit-step3>{{ 'kit_detail.open_step' | t }}</h3><p data-kit-step3-copy>{{ 'kit_detail.open_step_copy' | t }}</p></div></div>
    </div></section>
  </div>
  {% if customer %}
  <dialog class="kgd__modal" data-member-upgrade aria-labelledby="MemberUpgrade-{{ section.id }}"><button class="kgd__close" type="button" data-upgrade-close aria-label="{{ 'kit_detail.close' | t }}">×</button><p class="kgd__eyebrow">{{ 'kit_detail.eyebrow' | t }}</p><h2 id="MemberUpgrade-{{ section.id }}" data-upgrade-title></h2><p class="kgd__modal-lead">{{ 'kit_detail.upgrade_copy' | t }}</p>
    <div class="kgd__modal-benefit">{% render 'starter-kit-icon', name: 'clipboard' %}<p data-upgrade-benefit></p></div><div class="kgd__modal-benefit">{% render 'starter-kit-icon', name: 'pin' %}<p>{{ 'kit_detail.map_benefit' | t }}</p></div>
    <div class="kgd__compare"><div class="kgd__compare-card"><span class="kgd__pill">{{ 'kit_detail.selection' | t }}</span><h3 data-only-name></h3><strong class="kgd__compare-price" data-only-total></strong><p data-only-summary></p><p>{{ 'kit_detail.only_access' | t }}</p><p>{{ 'kit_detail.no_map' | t }}</p></div><div class="kgd__compare-card kgd__compare-card--kit"><span class="kgd__pill">{{ 'kit_detail.complete' | t }}</span><h3>{{ 'kit_detail.BUNDLE' | t }}</h3><strong class="kgd__compare-price" data-upgrade-price></strong><p data-upgrade-savings></p><hr><p>{{ 'kit_detail.kit_features' | t }}</p><p>{{ 'kit_detail.kit_access' | t }}</p></div></div>
    <p class="kgd__difference" data-upgrade-difference></p><div class="kgd__coupon" data-only-coupon hidden><label><input type="checkbox" data-only-extra checked><span data-only-extra-label></span></label><p>{{ 'kit_detail.coupon_hint' | t }}</p></div>
    <button type="button" class="kgd__button" data-upgrade-accept>{{ 'kit_detail.upgrade_accept' | t }}</button><button type="button" class="kgd__button kgd__button--outline" data-upgrade-keep></button><p class="kgd__modal-note">{{ 'kit_detail.review_total' | t }}</p>
  </dialog>
  <dialog class="kgd__modal kgd__extension" data-member-extension aria-labelledby="MemberExtension-{{ section.id }}"><button class="kgd__close" type="button" data-extension-close aria-label="{{ 'kit_detail.close' | t }}">×</button><h2 id="MemberExtension-{{ section.id }}">{{ 'member_catalog.extend_title' | t }}</h2><p>{{ 'member_catalog.extend_description' | t }}</p><div id="GuideExtensionRoot" data-customer-id="{{ customer.id }}"></div></dialog>
  <dialog class="kgd__modal kgd__share-modal" data-kit-share-dialog aria-labelledby="KitShare-{{ section.id }}"><button class="kgd__close" type="button" data-kit-share-close aria-label="{{ 'kit_detail.share_close' | t }}">×</button><h2 id="KitShare-{{ section.id }}">{{ 'kit_detail.referral_share' | t }}</h2><p>{{ 'kit_detail.share_ready' | t }}</p><a href="https://kpurpleshoes.com/pages/freeguideoptin">https://kpurpleshoes.com/pages/freeguideoptin</a><button class="kgd__button" type="button" data-kit-copy-link>{{ 'kit_detail.copy_link' | t }}</button><p data-kit-copy-status role="status"></p></dialog>
  {% endif %}
