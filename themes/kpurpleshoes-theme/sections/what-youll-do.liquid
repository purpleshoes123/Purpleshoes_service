{% comment %}
  Section: What you'll do (Left list style)
  - Thumbnail (rounded) + title + description
  - Blocks for items
{% endcomment %}

<section class="wyd" data-section-id="{{ section.id }}">
  {% liquid
    assign experience_highlights = product.metafields.custom.experience_highlights.value
    if experience_highlights == blank
      assign experience_highlights = product.metafields.custom.experience_highlight.value
    endif
    if experience_highlights == blank
      assign experience_highlights = product.metafields.custom.highlights.value
    endif
    if experience_highlights == blank
      assign experience_highlights = product.metafields.custom.highlight_items.value
    endif
    if experience_highlights == blank
      assign experience_highlights = product.metafields.custom.wyd_items.value
    endif
  %}
  <div class="wyd__inner page-width">
    {% if section.settings.heading != blank %}
      <div class="ps-section-heading wyd__title-wrap">
        <h2 class="ps-section-heading__title wyd__title">{{ section.settings.heading | escape }}</h2>
        <div class="ps-section-heading__rule"></div>
      </div>
    {% endif %}

    <div class="wyd__list" role="list">
      {% assign rendered_count = 0 %}
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="wyd__item" role="listitem" {{ block.shopify_attributes }}>
            <div class="wyd__thumb">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    widths: '90, 180, 200, 400',
                    sizes: '(max-width: 749px) 90px, 200px',
                    alt: block.settings.title
                }}
              {% else %}
                <div class="wyd__thumb--placeholder" aria-hidden="true"></div>
              {% endif %}
            </div>

            <div class="wyd__content">
              {% if block.settings.title != blank %}
                <div class="wyd__item-title">{{ block.settings.title | escape }}</div>
              {% endif %}
              {% if block.settings.desc != blank %}
                <div class="wyd__item-desc">{{ block.settings.desc | newline_to_br }}</div>
              {% endif %}
            </div>
          </div>
          {% assign rendered_count = rendered_count | plus: 1 %}
        {% endfor %}
      {% elsif experience_highlights != blank %}
        {% for item in experience_highlights %}
          {% assign item_img = item.thumbnail.value | default: item.img.value | default: item.image.value | default: item.icon.value | default: item.thumbnail | default: item.img | default: item.image | default: item.icon %}
          {% assign item_img_obj = item_img.image | default: item_img %}
          {% assign item_img_url = item.thumbnail_url.value | default: item.img_url.value | default: item.image_url.value | default: item.thumbnail_url | default: item.img_url | default: item.image_url %}
          {% assign item_title = item.title.value | default: item.label.value | default: item.name.value | default: item.title | default: item.label | default: item.name %}
          {% assign item_desc_field = item.desc | default: item.description | default: item.content %}
          {% assign item_desc_text = item.desc.value | default: item.description.value | default: item.content.value | default: item_desc_field %}
          <div class="wyd__item" role="listitem">
            <div class="wyd__thumb">
              {% if item_img_obj != blank %}
                {{
                  item_img_obj
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    widths: '80, 120, 160',
                    sizes: '(max-width: 749px) 64px, 72px',
                    alt: item_title
                }}
              {% elsif item_img_url != blank %}
                <img
                  src="{{ item_img_url | escape }}"
                  alt="{{ item_title | escape }}"
                  loading="lazy"
                  width="160"
                  height="160"
                >
              {% else %}
                <div class="wyd__thumb--placeholder" aria-hidden="true"></div>
              {% endif %}
            </div>

            <div class="wyd__content">
              {% if item_title != blank %}
                <div class="wyd__item-title">{{ item_title | escape }}</div>
              {% endif %}
              {% if item_desc_field != blank or item_desc_text != blank %}
                <div class="wyd__item-desc">
                  {% if item_desc_field.type == 'rich_text_field' %}
                    {{ item_desc_field | metafield_tag }}
                  {% else %}
                    {{ item_desc_text | escape | newline_to_br }}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
          {% assign rendered_count = rendered_count | plus: 1 %}
        {% endfor %}
      {% endif %}

      {% if rendered_count == 0 %}
        <div class="wyd__item" role="listitem">
          <div class="wyd__content">
            <div class="wyd__item-desc">No highlights found. Add section blocks in Theme Editor.</div>
          </div>
        </div>
      {% endif %}
    </div>

    {% if section.settings.note != blank %}
      <p class="wyd__note">{{ section.settings.note | newline_to_br }}</p>
    {% endif %}
  </div>

  <style>
    .wyd { width: 100%; }
    .wyd__inner {
      padding-top: 84px;
      padding-bottom: 84px;
    }

    .wyd__title{
      margin: 0 0 18px;
      font-size: clamp(20px, 2.2vw, 26px);
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: {{ section.settings.heading_color }};
    }

    .wyd__list{
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .wyd__item{
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 24px;
      align-items: center;
    }

    .wyd__thumb{
      width: 200px;
      height: 200px;
      border-radius: 16px;
      overflow: hidden;
      background: {{ section.settings.thumb_bg }};
      box-shadow: 0 4px 16px rgba(0,0,0,.08);
      flex-shrink: 0;
    }

    .wyd__thumb img{
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .wyd__thumb--placeholder{
      width: 100%;
      height: 100%;
      background:
        radial-gradient(circle at 30% 30%, rgba(0,0,0,.06), transparent 55%),
        linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.02));
    }

    .wyd__content{
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      min-width: 0;
    }

    .wyd__item-title{
      margin: 0 0 4px;
      font-size: 18px;
      font-weight: 700;
      color: {{ section.settings.title_color }};
      letter-spacing: -0.01em;
      line-height: 1.3;
    }

    .wyd__item-desc{
      margin: 0;
      font-size: 14px;
      line-height: 1.55;
      color: {{ section.settings.desc_color }};
      max-width: 100%;
    }

    .wyd__item-desc strong{
      font-weight: 700;
      color: {{ section.settings.title_color }};
      display: block;
      margin-top: 14px;
      margin-bottom: 2px;
      font-size: 15px;
    }

    .wyd__item-desc strong:first-child{
      margin-top: 0;
    }


    .wyd__note{
      margin: 24px 0 0;
      font-size: 13px;
      line-height: 1.5;
      color: {{ section.settings.note_color }};
      opacity: .9;
    }

    @media (max-width: 749px){
      .wyd__inner{ padding-left: 16px; padding-right: 16px; }
      .wyd__item{ grid-template-columns: 90px 1fr; gap: 16px; align-items: center; }
      .wyd__thumb{ width: 90px; height: 90px; border-radius: 12px; }
      .wyd__content{ min-width: 0; }
      .wyd__item-title{ font-size: 15px; }
      .wyd__item-desc{ font-size: 13px; }
      .wyd__item-desc strong{ font-size: 14px; margin-top: 10px; }
    }
  </style>
</section>

{% schema %}
{
  "name": "What you'll do (list)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you’ll do" },
    { "type": "textarea", "id": "note", "label": "Bottom note", "default": "This experience is hosted in English." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "color", "id": "title_color", "label": "Item title color", "default": "#1a1a1a" },
    { "type": "color", "id": "desc_color", "label": "Item description color", "default": "#6b7280" },
    { "type": "color", "id": "note_color", "label": "Note color", "default": "#6b7280" },
    { "type": "color", "id": "thumb_bg", "label": "Thumbnail background", "default": "#f3f4f6" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "label": "Padding top", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "label": "Padding bottom", "default": 28 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Thumbnail image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Explore night market" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "Wander through the vibrant energy of the night market." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "What you'll do (list)",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
