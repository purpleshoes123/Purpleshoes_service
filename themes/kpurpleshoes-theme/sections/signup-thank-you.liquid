{{ 'signup-thank-you.css' | asset_url | stylesheet_tag }}

{%- if customer -%}
  <script>
    try {
      var welcomeKey = 'ps_welcomed_{{ customer.id }}';
      if (!localStorage.getItem(welcomeKey)) localStorage.setItem(welcomeKey, '1');
    } catch (_error) {}
  </script>
{%- endif -%}

<section class="sgty">
  <div class="sgty__inner">
    <div class="sgty__ready">
      <div class="sgty__ready-heading">
        <span class="sgty__check" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m7 16 6 6L25 9"/></svg></span>
        <h1 class="sgty__headline">{{ section.settings.headline | escape }}</h1>
      </div>
      <div class="sgty__free">
        <div class="sgty__free-icons" aria-hidden="true"><span>{% render 'starter-kit-icon', name: 'play' %}</span><span>{% render 'starter-kit-icon', name: 'book' %}</span></div>
        <div class="sgty__free-copy"><p><strong>{{ section.settings.email_title | escape }}</strong></p><p>{{ section.settings.email_body | escape }}</p></div>
        <a class="sgty__free-link" href="/pages/starter-kit-viewer">{{ 'signup_thankyou.free_cta' | t }}</a>
      </div>
    </div>

    <div class="sgty__product-heading">
      <p class="sgty__eyebrow">{{ 'signup_thankyou.kit_name' | t }}</p>
      <h2 class="sgty__title">{{ section.settings.kit_title | escape }}</h2>
      <p class="sgty__description">{{ section.settings.kit_copy | escape }}</p>
    </div>

    <div class="sgty__showcase">
      <figure class="sgty__screen">
        <figcaption>{{ 'signup_thankyou.map_label' | t }}</figcaption>
        <div class="sgty__image"><img src="{{ 'signup-component-map.png' | asset_url }}" alt="{{ 'signup_thankyou.map_alt' | t | escape }}" width="583" height="538" loading="eager" fetchpriority="high"></div>
        <p class="sgty__tagline">{{ 'signup_thankyou.map_tagline' | t }}</p>
      </figure>
      <figure class="sgty__screen sgty__screen--book">
        <figcaption>{{ 'signup_thankyou.guidebook_label' | t }}</figcaption>
        <div class="sgty__image"><img src="{{ 'signup-component-guidebook.png' | asset_url }}" alt="{{ 'signup_thankyou.guidebook_alt' | t | escape }}" width="478" height="538" loading="eager"></div>
        <p class="sgty__tagline">{{ 'signup_thankyou.guidebook_tagline' | t }}</p>
      </figure>
      <figure class="sgty__screen">
        <figcaption>{{ 'signup_thankyou.video_label' | t }}</figcaption>
        <div class="sgty__image"><img src="{{ 'signup-component-video.png' | asset_url }}" alt="{{ 'signup_thankyou.video_alt' | t | escape }}" width="506" height="538" loading="eager"></div>
        <p class="sgty__tagline">{{ 'signup_thankyou.video_tagline' | t }}</p>
      </figure>
    </div>

    <div class="sgty__offer" data-sgty-offer-card>
      <div class="sgty__offer-price"><p class="sgty__offer-badge">{{ 'signup_thankyou.welcome_offer' | t }}</p>
        <div class="sgty__price"><span class="sgty__currency">USD</span><strong>75</strong></div>
        <p class="sgty__regular">{{ 'signup_thankyou.regular_price' | t }} <s>USD 150</s></p></div>
      <div class="sgty__offer-action"><a class="sgty__cta" href="{{ section.settings.cta_url | default: '/pages/guide-plans#member-purchase' | escape }}"><span>{{ section.settings.cta_label | escape }}</span>{% render 'starter-kit-icon', name: 'arrow' %}</a>
        <div class="sgty__facts">
          <p><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="16" cy="17" r="12"/><path d="M16 9v9l6 4M5 3 1 7m26-4 4 4"/></svg><span>{{ 'signup_thankyou.validity' | t }}</span></p>
          <p><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 23V5h21v10M1 26h18"/><rect x="21" y="15" width="9" height="15" rx="2"/></svg><span>{{ 'signup_thankyou.access' | t }}</span></p>
        </div></div>
    </div>

    <div class="sgty__trust">{% render 'starter-kit-icon', name: 'heart' %}<p>{{ 'signup_thankyou.trust_heading' | t }}<span>{{ 'signup_thankyou.trust_copy' | t }}</span></p></div>

    <div class="sgty__closing">
      <h2>{{ 'signup_thankyou.closing' | t }}</h2>
      <a class="sgty__cta" href="{{ section.settings.cta_url | default: '/pages/guide-plans#member-purchase' | escape }}"><span>{{ section.settings.cta_label | escape }}</span>{% render 'starter-kit-icon', name: 'arrow' %}</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Signup Thank You",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"text","id":"headline","label":"Account heading","default":"Your account is ready."},
    {"type":"text","id":"email_title","label":"Free Kit heading","default":"Your free Starter Kit is ready to open."},
    {"type":"text","id":"email_body","label":"Free Kit description","default":"Video + guidebook. No purchase required."},
    {"type":"text","id":"kit_title","label":"Kit heading","default":"Make Korea easier to explore."},
    {"type":"textarea","id":"kit_copy","label":"Kit description","default":"Find food and places you’ll love, with practical guidance for your trip."},
    {"type":"text","id":"cta_label","label":"Offer button text","default":"View My Korea Guide Kit Offer"},
    {"type":"url","id":"cta_url","label":"Kit detail URL"}
  ],
  "presets":[{"name":"Signup Thank You"}]
}
{% endschema %}
