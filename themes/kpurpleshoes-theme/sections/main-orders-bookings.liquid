<script src="{{ 'orders-bookings-reviews.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'booking-current-date.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var root = document.querySelector('[data-orders-bookings]');
  if (!root) return;

  /* ── Tab switching (URL로 구분: ?tab=orders | ?tab=booking) ── */
  var obTabs = root.querySelectorAll('[data-ob-tab]');
  var obPanels = root.querySelectorAll('[data-ob-tab-panel]');
  var OB_VALID_TABS = ['orders', 'booking'];

  function normalizeObTab(key) {
    if (key === 'bookings') return 'booking'; // 관용 표기 허용
    return OB_VALID_TABS.indexOf(key) !== -1 ? key : 'orders';
  }

  function getObTabFromUrl() {
    try {
      var params = new URLSearchParams(window.location.search);
      var q = params.get('tab');
      if (q) return normalizeObTab(q.toLowerCase());
      var hash = (window.location.hash || '').replace('#', '').toLowerCase();
      if (hash) return normalizeObTab(hash);
    } catch (e) {}
    return 'orders';
  }

  function syncObTabToUrl(key) {
    try {
      var url = new URL(window.location.href);
      url.searchParams.set('tab', key);
      url.hash = '';
      window.history.replaceState({ obTab: key }, '', url.toString());
    } catch (e) {}
  }

  function openObTab(key, updateUrl) {
    key = normalizeObTab(key);
    obTabs.forEach(function(tab) {
      tab.classList.toggle('is-active', tab.getAttribute('data-ob-tab') === key);
    });
    obPanels.forEach(function(panel) {
      var active = panel.getAttribute('data-ob-tab-panel') === key;
      panel.hidden = !active;
      panel.classList.toggle('is-active', active);
    });
    if (updateUrl !== false) syncObTabToUrl(key);
  }
  obTabs.forEach(function(tab) {
    tab.addEventListener('click', function() { openObTab(tab.getAttribute('data-ob-tab')); });
  });
  // 뒤로/앞으로 가기 시 URL의 탭 상태 반영
  window.addEventListener('popstate', function() { openObTab(getObTabFromUrl(), false); });
  // 초기 로드: URL의 ?tab= 값으로 탭 열기(없으면 orders), URL도 정규화
  openObTab(getObTabFromUrl());

  /* ── Booking guest breakdown fallback ── */
  function normalizeGuestCount(value) {
    var count = parseInt(value, 10);
    if (isNaN(count) || count < 0) return 0;
    return count;
  }

  function normalizeGuestKey(value) {
    return String(value || '').toLowerCase().replace(/[\s_-]/g, '');
  }

  function pickGuestCount(data, keys) {
    if (!data || typeof data !== 'object' || Array.isArray(data)) return 0;
    for (var i = 0; i < keys.length; i += 1) {
      var value = data[keys[i]];
      if (value !== undefined && value !== null && value !== '') {
        return normalizeGuestCount(value);
      }
    }

    var normalizedLookup = {};
    keys.forEach(function(key) {
      normalizedLookup[normalizeGuestKey(key)] = true;
    });

    var dataKeys = Object.keys(data);
    for (var j = 0; j < dataKeys.length; j += 1) {
      var dataKey = dataKeys[j];
      if (!normalizedLookup[normalizeGuestKey(dataKey)]) continue;
      var normalizedValue = data[dataKey];
      if (normalizedValue !== undefined && normalizedValue !== null && normalizedValue !== '') {
        return normalizeGuestCount(normalizedValue);
      }
    }

    return 0;
  }

  function getTravelersData(data) {
    if (!data || typeof data !== 'object') return null;
    if (Array.isArray(data)) return data;
    if (data.travelers && typeof data.travelers === 'object') return data.travelers;
    if (data.guestCounts && typeof data.guestCounts === 'object') return data.guestCounts;
    if (data.guests && typeof data.guests === 'object') return data.guests;
    return data;
  }

  function typeFromText(value) {
    var text = String(value || '').toLowerCase();
    if (!text) return '';
    if (text.indexOf('adult') !== -1 || text.indexOf('성인') !== -1) return 'adult';
    if (text.indexOf('infant') !== -1 || text.indexOf('baby') !== -1 || text.indexOf('toddler') !== -1 || text.indexOf('유아') !== -1 || text.indexOf('영아') !== -1) return 'infant';
    if (text.indexOf('child') !== -1 || text.indexOf('children') !== -1 || text.indexOf('teen') !== -1 || text.indexOf('youth') !== -1 || text.indexOf('청소년') !== -1 || text.indexOf('어린이') !== -1) return 'child';
    return '';
  }

  function countsFromArray(items) {
    var counts = { adult: 0, child: 0, infant: 0 };
    items.forEach(function(item) {
      if (!item || typeof item !== 'object') return;
      var type = typeFromText(item.type || item.ticketType || item.ticket_type || item.label || item.name || item.title);
      if (!type) return;
      var count = normalizeGuestCount(item.count || item.quantity || item.qty || item.value);
      counts[type] += count;
    });
    return counts;
  }

  function formatGuestBreakdown(adult, child, infant) {
    var total = adult + child + infant;
    if (total <= 0) return '';
    var parts = [];
    if (adult > 0) parts.push('Adult ' + adult);
    if (child > 0) parts.push('Child ' + child);
    if (infant > 0) parts.push('Infant ' + infant);
    return parts.join(', ');
  }

  function applyTravelersJsonGuests() {
    root.querySelectorAll('[data-booking-guests][data-travelers-json]').forEach(function(el) {
      if (el.getAttribute('data-guest-breakdown') === 'true') return;
      var raw = el.getAttribute('data-travelers-json');
      if (!raw) return;

      var data;
      try {
        data = JSON.parse(raw);
      } catch (error) {
        return;
      }
      var travelersData = getTravelersData(data);
      if (!travelersData || typeof travelersData !== 'object') return;

      var counts = Array.isArray(travelersData)
        ? countsFromArray(travelersData)
        : {
          adult: pickGuestCount(travelersData, ['adult', 'adults', 'adult_count', 'adultCount', 'travelers_adult', 'travelersAdult']),
          child: pickGuestCount(travelersData, ['child', 'children', 'teen', 'teens', 'youth', 'child_count', 'childCount', 'teen_count', 'teenCount', 'travelers_child', 'travelersChild']),
          infant: pickGuestCount(travelersData, ['infant', 'infants', 'infant_count', 'infantCount', 'travelers_infant', 'travelersInfant'])
        };
      var adult = counts.adult || 0;
      var child = counts.child || 0;
      var infant = counts.infant || 0;
      var label = formatGuestBreakdown(adult, child, infant);
      if (label) el.textContent = label;
    });
  }

  applyTravelersJsonGuests();

  /* ── Days remaining calculation ── */
  var accessUnavailableLabel = {{ 'access_details.unavailable' | t | json }};
  var accessUnavailableStatus = {{ 'access_details.status_unavailable' | t | json }};
  var KST_OFFSET_MS = 9 * 60 * 60 * 1000;
  var MS_PER_DAY = 86400000;
  var entitlementRows = Array.prototype.slice.call(root.querySelectorAll('[data-order-days]'));

  function setDaysValue(row, label, tone) {
    var valueEl = row ? row.querySelector('[data-days-value]') : null;
    if (!valueEl) return;
    valueEl.textContent = label;
    valueEl.style.color = '';
    if (tone === 'expired') valueEl.style.color = '#ef4444';
    else if (tone === 'soon') valueEl.style.color = '#f59e0b';
  }

  function setAccessStatus(row, label, tone) {
    var card = row ? row.closest('[data-order-card]') : null;
    var badge = card ? card.querySelector('[data-order-access-status]') : null;
    if (!badge) return;

    badge.textContent = label;
    badge.classList.remove('ob-status-badge--success', 'ob-status-badge--critical', 'ob-status-badge--attention', 'ob-status-badge--neutral');
    badge.classList.add(tone === 'expired' ? 'ob-status-badge--critical' : tone === 'unavailable' ? 'ob-status-badge--neutral' : 'ob-status-badge--success');
    if (card) card.classList.toggle('ob-card--inactive', tone === 'expired');
  }

  function kstDateStartMs(value) {
    var date = value instanceof Date ? value : new Date(String(value));
    if (isNaN(date.getTime())) return null;
    var kstDate = new Date(date.getTime() + KST_OFFSET_MS);
    return Date.UTC(kstDate.getUTCFullYear(), kstDate.getUTCMonth(), kstDate.getUTCDate());
  }

  function remainingDaysFromExpiry(expiresAt) {
    var expiryDay = kstDateStartMs(expiresAt);
    var today = kstDateStartMs(new Date());
    if (expiryDay === null || today === null) return null;
    return Math.floor((expiryDay - today) / MS_PER_DAY);
  }

  function formatExpiryDate(expiresAt) {
    var date = new Date(String(expiresAt));
    if (isNaN(date.getTime())) return '';
    return new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Seoul',
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    }).format(date);
  }

  function applyRemainingDays(row, remaining, expiresAt) {
    if (typeof remaining !== 'number' || !isFinite(remaining)) {
      applyAccessUnavailable(row);
      return;
    }
    var expiryDate = formatExpiryDate(expiresAt);
    if (remaining < 0) {
      setDaysValue(row, expiryDate ? 'Expired · Ended on ' + expiryDate : 'Expired', 'expired');
      setAccessStatus(row, 'Expired', 'expired');
      return;
    }
    setDaysValue(row, remaining + ' days' + (expiryDate ? ' · Ends on ' + expiryDate : ''), remaining <= 30 ? 'soon' : '');
    setAccessStatus(row, 'Active', 'active');
  }

  function applyAccessUnavailable(row) {
    setDaysValue(row, accessUnavailableLabel);
    setAccessStatus(row, accessUnavailableStatus, 'unavailable');
  }

  function buildEntitlementsUrl(customerId) {
    return '/apps/bta-booking/guide-extension/entitlements?logged_in_customer_id=' +
      encodeURIComponent(customerId) + '&_ts=' + Date.now();
  }

  function getEntitlementItemsByType(data) {
    var itemsByType = {};
    if (!data || !Array.isArray(data.items)) return itemsByType;
    data.items.forEach(function(item) {
      if (item && item.type) itemsByType[item.type] = item;
    });
    return itemsByType;
  }

  function pickEntitlementForRow(row, itemsByType, uiHints) {
    var type = row.getAttribute('data-guide-type') || '';
    var item = itemsByType[type] || null;
    var bundleItem = itemsByType.BUNDLE || null;
    if (
      (!item || item.status === 'NONE') &&
      bundleItem &&
      bundleItem.status === 'ACTIVE' &&
      ((type === 'PDF' && uiHints && uiHints.pdfAccessViaBundle) ||
        (type === 'VIDEO' && uiHints && uiHints.videoAccessViaBundle))
    ) {
      return bundleItem;
    }
    return item;
  }

  function applyEntitlementDays(data) {
    var itemsByType = getEntitlementItemsByType(data);
    var uiHints = (data && data.uiHints) || {};
    entitlementRows.forEach(function(row) {
      var item = pickEntitlementForRow(row, itemsByType, uiHints);
      if (!item || (item.status !== 'ACTIVE' && item.status !== 'EXPIRED')) {
        applyAccessUnavailable(row);
        return;
      }
      if (item.status === 'EXPIRED') {
        var expiredDate = formatExpiryDate(item.expiresAtKst);
        setDaysValue(row, expiredDate ? 'Expired · Ended on ' + expiredDate : 'Expired', 'expired');
        setAccessStatus(row, 'Expired', 'expired');
        return;
      }
      applyRemainingDays(row, remainingDaysFromExpiry(item.expiresAtKst), item.expiresAtKst);
    });
  }

  function loadEntitlementDays() {
    if (!entitlementRows.length) return;
    var customerId = root.getAttribute('data-customer-id');
    if (!customerId) {
      entitlementRows.forEach(applyAccessUnavailable);
      return;
    }
    fetch(buildEntitlementsUrl(customerId), {
      method: 'GET',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    })
      .then(function(response) {
        return response.json().then(function(payload) {
          if (!response.ok || !payload || payload.ok === false) {
            throw new Error('entitlements failed');
          }
          return payload.data || payload;
        });
      })
      .then(applyEntitlementDays)
      .catch(function(error) {
        console.warn('[Orders & Bookings] Unable to load entitlement days:', error);
        entitlementRows.forEach(applyAccessUnavailable);
      });
  }

  loadEntitlementDays();

  /* ── Extension Modal ── */
  var extensionModal = root.querySelector('[data-extension-modal]');
  var extensionModalTitle = root.querySelector('[data-extension-modal-title]');
  var extensionModalDesc = root.querySelector('[data-extension-modal-desc]');
  var extensionModalCloseEls = root.querySelectorAll('[data-extension-modal-close]');

  function openExtensionModal(type, label) {
    if (extensionModal) extensionModal.hidden = false;
    if (extensionModalTitle) extensionModalTitle.textContent = label ? 'Extend ' + label : 'Extend Access Period';
    if (extensionModalDesc) extensionModalDesc.textContent = label
      ? 'Select how many 30-day units you want to add to your ' + label + ', then proceed to checkout.'
      : 'Select how many 30-day units you want to add, then proceed to checkout.';
    document.dispatchEvent(new CustomEvent('guide-extension:select-type', { detail: { type: type } }));
  }
  function closeExtensionModal() {
    if (extensionModal) extensionModal.hidden = true;
  }
  root.querySelectorAll('[data-open-extension]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      openExtensionModal(btn.getAttribute('data-extension-type'), btn.getAttribute('data-extension-label') || '');
    });
  });
  extensionModalCloseEls.forEach(function(el) { el.addEventListener('click', closeExtensionModal); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && extensionModal && !extensionModal.hidden) closeExtensionModal();
  });

  /* Cancelled/refunded records remain in Shopify for accounting, but customers
     can remove them from this My Page list. The preference is stored on the
     customer account so it follows the customer across devices. */
  var orderVisibilityEndpoint = '/apps/bta-booking/orders/visibility';
  function hideSavedOrders(ids) {
    if (!Array.isArray(ids)) return;
    ids.forEach(function(id) {
      root.querySelectorAll('[data-my-order-card][data-order-id="' + String(id).replace(/"/g, '') + '"]').forEach(function(card) {
        card.hidden = true;
      });
    });
  }
  fetch(orderVisibilityEndpoint, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
    .then(function(response) { return response.ok ? response.json() : null; })
    .then(function(payload) { hideSavedOrders(payload && payload.data && payload.data.hiddenOrderIds); })
    .catch(function() {});
  root.addEventListener('click', function(event) {
    var button = event.target.closest('[data-hide-order]');
    if (!button) return;
    var orderId = button.getAttribute('data-order-id');
    if (!orderId || !window.confirm('Remove this cancelled or refunded item from your list?')) return;
    button.disabled = true;
    fetch(orderVisibilityEndpoint, {
      method: 'POST', credentials: 'same-origin', headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'hide', orderId: orderId })
    }).then(function(response) { return response.ok ? response.json() : Promise.reject(); })
      .then(function() { hideSavedOrders([orderId]); })
      .catch(function() { button.disabled = false; });
  });
})();
</script>


{%- else -%}
  {% render 'member-login-required' %}
{%- endif -%}
