            "button_link": "shopify://collections/all",
            "small_note": "* Instant download after payment (sample)",
            "f1": "1-2 recommended routes by area",
            "f2": "Includes Purple Map places (Kakao Map)",
            "f3": "Budget and travel time guidance",
            "f4": "Simple trip prep checklist"
          }
        },
        {
          "type": "plan",
          "settings": {
            "featured": true,
            "badge_soft": "BASIC",
            "badge_solid": "ALL-IN",
            "title": "Korean Guide Kit",
            "desc": "A PDF guidebook covering key routes, restaurants, and photo spots.",
            "price_amount": "₩59,000",
            "price_unit": "/ 1 trip",
            "button_label": "Select plan",
            "button_link": "shopify://products/korea-guide-kit",
            "small_note": "* Provided by link (sample)",
            "f1": "Video guide for key sections (for example, 20-40 minutes)",
            "f2": "Captioned explanations by point (sample)",
            "f3": "Route tips for common mistakes",
