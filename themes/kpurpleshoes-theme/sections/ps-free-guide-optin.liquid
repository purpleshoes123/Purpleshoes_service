{{ 'free-guide-optin.css' | asset_url | stylesheet_tag }}

<div
  class="fgo"
  data-fgo-section
  data-section-id="{{ section.id }}"
  data-mailer-endpoint="/apps/bta-booking/mail/request"
  data-template-slug="{{ section.settings.mailer_template_slug | default: 'squeeze' | escape }}"
  data-recaptcha-site-key="{{ section.settings.mail_recaptcha_site_key | escape }}"
  data-recaptcha-action="{{ section.settings.mail_recaptcha_action | default: 'mail_request_submit' | escape }}"
  data-success-redirect-url="https://kpurpleshoes.com/pages/squeezthank"
  data-klaviyo-api-key="{{ section.settings.klaviyo_api_key | escape }}"
  data-klaviyo-list-id="{{ section.settings.klaviyo_list_id | default: 'VkipLH' | escape }}"
  data-submit-label="{{ section.settings.cta_label | default: 'Unlock My Free Starter Kit' | escape }}"
  data-submit-loading-label="Sending..."
>


  <img class="fgo__scenery" src="{{ 'free-guide-seoul.svg' | asset_url }}" alt="" width="1440" height="650" aria-hidden="true">
  <div class="fgo__logobar">
    <a class="fgo__logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 320
        | image_tag:
          class: 'fgo__logo',
          alt: shop.name,
          loading: 'eager'
      }}
    {%- else -%}
      <span class="fgo__logo-text">{{ shop.name }}</span>
    {%- endif -%}
    </a>
  </div>


  <div class="fgo__hero">
    <span class="fgo__section-label">{{ section.settings.section_label | default: "Free Korea Travel Info" }}</span>
    <h1 class="fgo__headline">{{ section.settings.headline | escape | newline_to_br }}</h1>
    <p class="fgo__subtext">{{ section.settings.subtext | escape | newline_to_br }}</p>
  </div>


  <div class="fgo__cta-bar">
    <div class="fgo__cta-inner">
      <p class="fgo__cta-eyebrow">{{ section.settings.cta_eyebrow | default: "FREE • NO CREDIT CARD REQUIRED" }}</p>
      <h2 class="fgo__sr-only">{{ section.settings.cta_title | escape }}</h2>
      <form class="fgo__form" id="FgoForm-{{ section.id }}" data-fgo-form novalidate>
        <div class="fgo__input-wrap">
          <label class="fgo__email-label" for="FgoEmail-{{ section.id }}">{{ 'free_guide_optin.email_label' | t }}</label>
          <input
            type="email"
            class="fgo__input"
            id="FgoEmail-{{ section.id }}"
            name="email"
            placeholder="{{ section.settings.email_placeholder | default: 'Enter your email address' | escape }}"
            autocomplete="email"
            required
            data-fgo-email
            autocapitalize="none"
            spellcheck="false"
          >
        </div>

        <label class="fgo__marketing-consent">
          <input type="checkbox" data-fgo-marketing-consent aria-describedby="FgoConsentHelp-{{ section.id }}">
          <span>{{ 'free_guide_optin.marketing_consent' | t }}<span class="fgo__consent-helper" id="FgoConsentHelp-{{ section.id }}">{{ 'free_guide_optin.marketing_helper' | t }}</span></span>
        </label>
        <button
          type="submit"
          class="fgo__submit"
          id="FgoSubmit-{{ section.id }}"
          data-fgo-submit
        >
          {{ section.settings.cta_label | default: "Unlock My Free Starter Kit" }}
        </button>
<p class="fgo__submit-notice">{{ 'free_guide_optin.submitting_notice' | t }}</p>
        <div
          class="fgo__captcha-slot"
          id="FgoCaptcha-{{ section.id }}"
          data-captcha
          aria-label="{{ 'free_guide_optin.captcha_label' | t | escape }}"
        >
          <svg class="fgo__shield" viewBox="0 0 32 36" fill="currentColor" aria-hidden="true"><path d="m16 1 13 5v10c0 9-6 15-13 19C9 31 3 25 3 16V6z"/><path d="m10 18 4 4 8-9" fill="none" stroke="#fff" stroke-width="3"/></svg>
          <div>
          <p class="fgo__captcha-title">{{ 'free_guide_optin.captcha_title' | t }}</p>
          <p class="fgo__captcha-copy" data-fgo-captcha-status>
            {{ 'free_guide_optin.captcha_copy' | t }}
          </p>
          <p class="fgo__captcha-legal">
            {{ 'free_guide_optin.captcha_legal_html' | t }}
          </p>
          </div>
        </div>

        <p class="fgo__status" id="FgoStatus-{{ section.id }}" data-fgo-status aria-live="polite" hidden></p>
      </form>

      <div class="fgo__success" id="FgoSuccess-{{ section.id }}" data-fgo-success aria-live="polite" hidden>
        <div class="fgo__success-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="5,12 10,17 19,8"/>
          </svg>
        </div>
        <p class="fgo__success-title">{{ 'free_guide_optin.success_title' | t }}</p>
        <p class="fgo__success-sub">{{ 'free_guide_optin.success_copy' | t }}</p>
        <p class="fgo__subscription-notice" data-fgo-subscription-notice hidden>{{ 'free_guide_marketing.incomplete' | t }}</p>
        <a class="fgo__submit" href="/pages/squeezthank">{{ 'free_guide_optin.success_link' | t }}</a>
      </div>
    </div>
  </div>

  <div class="fgo__card">
    <div class="fgo__card-inner">
      <h2 class="fgo__benefits-head">{{ 'free_guide_optin.benefits_heading' | t }}</h2>
      <ul class="fgo__benefits" aria-label="{{ 'free_guide_optin.benefits_label' | t | escape }}">
        <li class="fgo__benefit-group">
          <div class="fgo__benefit-group-title">
            <span class="fgo__check" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="currentColor"><path d="m28 18-10-7V4a2 2 0 0 0-4 0v7L4 18v4l10-4v7l-4 3v2l6-2 6 2v-2l-4-3v-7l10 4z"/></svg>
            </span>
            {{ 'free_guide_optin.pre_trip.title' | t }}
          </div>
          <ul class="fgo__benefit-items">
            <li>{{ 'free_guide_optin.pre_trip.item_1' | t }}</li>
            <li>{{ 'free_guide_optin.pre_trip.item_2' | t }}</li>
            <li>{{ 'free_guide_optin.pre_trip.item_3' | t }}</li>
            <li>{{ 'free_guide_optin.pre_trip.item_4' | t }}</li>
          </ul>
        </li>
        <li class="fgo__benefit-group">
          <div class="fgo__benefit-group-title">
            <span class="fgo__check" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.8"><rect x="6" y="3" width="20" height="23" rx="5" fill="currentColor"/><rect x="10" y="7" width="12" height="8" rx="2" fill="#eee5ff" stroke="none"/><path d="m11 26-4 5m14-5 4 5"/><circle cx="11" cy="21" r="1" stroke="#eee5ff"/><circle cx="21" cy="21" r="1" stroke="#eee5ff"/></svg>
            </span>
            {{ 'free_guide_optin.local.title' | t }}
          </div>
          <ul class="fgo__benefit-items">
            <li>{{ 'free_guide_optin.local.item_1' | t }}</li>
            <li>{{ 'free_guide_optin.local.item_2' | t }}</li>
            <li>{{ 'free_guide_optin.local.item_3' | t }}</li>
            <li>{{ 'free_guide_optin.local.item_4' | t }}</li>
          </ul>
        </li>
        <li class="fgo__benefit-group">
          <div class="fgo__benefit-group-title">
            <span class="fgo__check" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 2A11 11 0 0 0 5 13c0 8 11 18 11 18s11-10 11-18A11 11 0 0 0 16 2m0 16a5 5 0 1 1 0-10 5 5 0 0 1 0 10"/></svg>
            </span>
            {{ 'free_guide_optin.planning.title' | t }}
          </div>
          <ul class="fgo__benefit-items">
            <li>{{ 'free_guide_optin.planning.item_1' | t }}</li>
            <li>{{ 'free_guide_optin.planning.item_2' | t }}</li>
            <li>{{ 'free_guide_optin.planning.item_3' | t }}</li>
            <li>{{ 'free_guide_optin.planning.item_4' | t }}</li>

          </ul>
        </li>
      </ul>
    </div>
  </div>



  <div class="fgo__closing">
    <h2 class="fgo__benefits-tagline">{{ 'free_guide_optin.tagline' | t }}</h2>
    <span class="fgo__closing-rule" aria-hidden="true"></span>
    <p class="fgo__closing-copy">{{ 'free_guide_optin.closing_copy' | t }}</p>
  </div>
</div>

<script src="{{ 'free-guide-optin.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "PS Free Guide Opt-in",
  "settings": [
    {
      "type": "header",
      "content": "Hero Copy"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Eyebrow pill label",
      "default": "FREE KOREA TRAVEL STARTER KIT"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "The Essentials for Your First Korea Trip"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Sub-text",
      "default": "No more jumping between blogs, maps, and random tips.\nGet the essentials for your first Korea trip in one free video and guidebook."
    },
    {
      "type": "header",
      "content": "Left Media"
    },
    {
      "type": "image_picker",
      "id": "media_image",
      "label": "Image (used when no video URL)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video embed URL (takes priority over image)",
      "info": "Paste a YouTube or Vimeo embed URL"
    },
    {
      "type": "text",
      "id": "media_badge",
      "label": "Media badge label",
      "default": "Preview"
    },
    {
      "type": "textarea",
      "id": "media_placeholder_text",
      "label": "Placeholder text (no image/video)",
      "default": "Video: Navigating Korea's top spots using in-app map pins — screen recorded for you."
    },
    {
      "type": "header",
      "content": "CTA Bar"
    },
    {
      "type": "text",
      "id": "cta_eyebrow",
      "label": "CTA eyebrow / social proof",
      "default": "FREE • NO CREDIT CARD REQUIRED"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA section title",
      "default": "Get Instant Access to the Free Starter Kit"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Unlock My Free Starter Kit"
    },
    {
      "type": "header",
      "content": "Mailer Settings"
    },
    {
      "type": "text",
      "id": "mailer_template_slug",
      "label": "Mailer template slug",
      "default": "squeeze"
    },
    {
      "type": "text",
      "id": "mail_recaptcha_site_key",
      "label": "reCAPTCHA site key"
    },
    {
      "type": "text",
      "id": "mail_recaptcha_action",
      "label": "reCAPTCHA action",
      "default": "mail_request_submit"
    },
    {
      "type": "header",
      "content": "Klaviyo Settings"
    },
    {
      "type": "text",
      "id": "klaviyo_api_key",
      "label": "Klaviyo public API key"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo list ID",
      "default": "VkipLH"
    }
  ],
  "presets": [
    {
      "name": "PS Free Guide Opt-in"
    }
  ]
}
{% endschema %}
