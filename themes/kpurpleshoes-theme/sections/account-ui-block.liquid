<section class="mp-wrap" data-mypage>
  <div class="mp-grid">

    <!-- LEFT SIDEBAR -->
    {% render 'mypage-sidebar', active: 'orders' %}

    <!-- RIGHT CONTENT -->
    <main class="mp-main">

      <!-- TAB: ORDERS -->
      <section class="mp-panel is-active" data-panel="orders" aria-label="Orders & Bookings">
        <h2 class="mp-h2">Orders &amp; Bookings</h2>
        <div class="mp-blank">
          <p>You can place the orders/bookings list UI here.</p>
          <p class="mp-muted">Shopify order history is typically rendered from the `orders` object on the `/account` page.</p>
        </div>
      </section>

      <!-- TAB: COUPONS -->
      <section class="mp-panel" data-panel="coupons" aria-label="My Coupons">
        <h2 class="mp-h2">My Coupons</h2>
        <div class="mp-blank">
          <p>Coupon and promotion UI area</p>
          <p class="mp-muted">Shopify does not provide a built-in “My Coupons” list by default, so this is usually integrated with an app or membership system.</p>
        </div>
      </section>

      <!-- TAB: HELP -->
      <section class="mp-panel" data-panel="help" aria-label="Help Center">
        <h2 class="mp-h2">Help Center</h2>
        <div class="mp-blank">
          <p>Inquiry, FAQ, and guide link area</p>
        </div>
      </section>

    </main>
  </div>

  <!-- MODAL -->
  <div class="mp-modal" aria-hidden="true" data-modal>
    <div class="mp-modal__backdrop" data-modal-close></div>
    <div class="mp-modal__card" role="dialog" aria-modal="true" aria-label="Confirm delete">
      <h3 class="mp-modal__title">Delete this card?</h3>
      <p class="mp-modal__desc">This action cannot be undone. Are you sure you want to delete it?</p>
      <div class="mp-modal__actions">
        <button class="mp-btn mp-btn--small" type="button" data-modal-close>Cancel</button>
        <button class="mp-btn mp-btn--danger" type="button" data-confirm-delete>Delete</button>
      </div>
    </div>
  </div>
</section>

<style>
  .mp-wrap{
    padding: 56px 20px;
  }

  /* RIGHT */
  .mp-main{ min-width: 0; }
  .mp-panel{ display:none; }
  .mp-panel.is-active{ display:block; }

  .mp-h2{
    margin: 0 0 14px;
    font-size: 28px;
    font-weight: 800;
  }
  .mp-h3{
    margin: 26px 0 10px;
    font-size: 22px;
    font-weight: 800;
  }
  .mp-h3--inline{ margin: 0; }

  .mp-row{
    display: grid;
    gap: 14px;
    margin-bottom: 14px;
  }
  .mp-row--2{
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .mp-row--country{
    grid-template-columns: 120px 1fr;
  }

  .mp-field{ display:block; }
  .mp-label{
    display:block;
    margin-bottom: 8px;
    font-size: 16px;
    font-weight: 700;
  }
  .mp-input{
    width: 100%;
    height: 64px;
    background: #9942D8;
    border: 2px solid #1a2a44;
    color: #fff;
    padding: 0 16px;
    font-size: 18px;
    font-weight: 700;
    border-radius: 0;
  }
  .mp-input::placeholder{ color: rgba(255,255,255,.75); }
  .mp-select{
    padding-right: 10px;
  }

  .mp-actions{
    margin-top: 18px;
  }
  .mp-actions--cards{
    display:flex;
    gap: 14px;
    justify-content: flex-end;
    margin-top: 14px;
  }

  .mp-btn{
    height: 54px;
    padding: 0 18px;
    border: 2px solid #1a2a44;
    background: #9942D8;
    color: #fff;
    font-weight: 800;
    font-size: 18px;
    cursor: pointer;
  }
  .mp-btn--cta{
    min-width: 260px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    float: right;
  }
  .mp-btn--small{
    height: 44px;
    font-size: 16px;
  }
  .mp-btn--primary{
    background: #9942D8;
  }
  .mp-btn--danger{
    background: #9942D8;
    position: relative;
  }
  .mp-btn--danger:hover{ filter: brightness(.95); }

  .mp-note{
    clear: both;
    margin: 10px 0 0;
    font-size: 13px;
    color: rgba(0,0,0,.55);
    line-height: 1.45;
  }

  .mp-saved{
    margin-top: 28px;
  }
  .mp-saved__head{
    display:flex;
    align-items:center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .mp-warn{
    margin-top: 14px;
    display:inline-block;
    padding: 10px 12px;
    background: #f3b07a;
    color: #000;
    font-weight: 800;
    border-left: 4px solid #c85a2e;
  }

  .mp-blank{
    border: 1px dashed rgba(0,0,0,.2);
    padding: 18px;
  }
  .mp-muted{ color: rgba(0,0,0,.55); }

  /* MODAL */
  .mp-modal{
    position: fixed;
    inset: 0;
    display: none;
    z-index: 9999;
  }
  .mp-modal.is-open{ display:block; }
  .mp-modal__backdrop{
    position:absolute; inset:0;
    background: rgba(0,0,0,.55);
  }
  .mp-modal__card{
    position: relative;
    width: min(520px, calc(100% - 40px));
    margin: 16vh auto 0;
    background: #fff;
    border: 2px solid #1a2a44;
    padding: 18px;
  }
  .mp-modal__title{
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 900;
  }
  .mp-modal__desc{
    margin: 0 0 14px;
    color: rgba(0,0,0,.68);
    line-height: 1.5;
  }
  .mp-modal__actions{
    display:flex;
    justify-content:flex-end;
    gap: 10px;
  }

  /* Responsive */
  @media (max-width: 980px){
    .mp-grid{
      grid-template-columns: 1fr;
    }
    .mp-btn--cta{
      float: none;
      width: 100%;
      min-width: 0;
    }
    .mp-row--2{ grid-template-columns: 1fr; }
    .mp-row--country{ grid-template-columns: 140px 1fr; }
  }
</style>

<script>
  (function(){
    var root = document.querySelector('[data-mypage]');
    if(!root) return;

    var navItems = Array.prototype.slice.call(root.querySelectorAll('.mp-navItem'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('.mp-panel'));

    function openTab(key){
      navItems.forEach(function(btn){
        btn.classList.toggle('is-active', btn.getAttribute('data-tab') === key);
      });
      panels.forEach(function(p){
        p.classList.toggle('is-active', p.getAttribute('data-panel') === key);
      });
    }

    navItems.forEach(function(btn){
      btn.addEventListener('click', function(){
        openTab(btn.getAttribute('data-tab'));
      });
    });

    // Modal (Delete card confirmation)
    var modal = root.querySelector('[data-modal]');
    var openDelete = root.querySelector('[data-delete-card]');
    var closeEls = Array.prototype.slice.call(root.querySelectorAll('[data-modal-close]'));
    var confirmDelete = root.querySelector('[data-confirm-delete]');

    function openModal(){
      if(!modal) return;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
    }
    function closeModal(){
      if(!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    }

    if(openDelete){
      openDelete.addEventListener('click', openModal);
    }
    closeEls.forEach(function(el){
      el.addEventListener('click', closeModal);
    });

    if(confirmDelete){
      confirmDelete.addEventListener('click', function(){
        var card = root.querySelector('#mp-card');
        var exp = root.querySelector('#mp-exp');
        var cvv = root.querySelector('#mp-cvv');
        if(card) card.value = '';
        if(exp) exp.value = '';
        if(cvv) cvv.value = '';
        closeModal();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "My Page UI Block",
  "settings": [],
  "presets": [{ "name": "My Page UI Block" }]
}
{% endschema %}
