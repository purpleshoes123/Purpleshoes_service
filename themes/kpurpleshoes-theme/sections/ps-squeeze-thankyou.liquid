{{ 'squeeze-thankyou.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign default_helper = 'squeeze_thankyou.access_note' | t
-%}

<div class="sqty">
  <div class="sqty__logobar">
    <a class="sqty__logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 640
          | image_tag:
            class: 'sqty__logo',
            alt: shop.name,
            loading: 'eager'
        }}
      {%- else -%}
        <span class="sqty__logo-text">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>
  </div>

  <div class="sqty__hero">
    <div class="sqty__hero-inner">
      <div class="sqty__check-badge" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 25 8 10 17-24"/>
        </svg>
      </div>
      <h1 class="sqty__hero-title">{{ section.settings.hero_title | escape | newline_to_br }}</h1>
      <p class="sqty__hero-sub">{{ section.settings.hero_sub | escape | newline_to_br }}</p>
      <a href="{{ section.settings.cta_url | default: '/pages/starter-kit-viewer' | escape }}" class="sqty__cta-btn">
        {{ section.settings.cta_label | default: 'Open My Free Starter Kit' | escape }}
      </a>
      <p class="sqty__hero-note">{{ section.settings.hero_note | default: default_helper | escape | newline_to_br }}</p>
    </div>
  </div>

  <ul class="sqty__features" aria-label="{{ 'squeeze_thankyou.features_label' | t | escape }}">
    <li class="sqty__feature">
      <span class="sqty__feature-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="currentColor"><path d="M15 8a3 3 0 0 1 4-2l24 15a3.5 3.5 0 0 1 0 6L19 42a3 3 0 0 1-4-2z"/></svg>
      </span>
      <p class="sqty__feature-caption">{{ 'squeeze_thankyou.video_html' | t }}</p>
    </li>
    <li class="sqty__feature">
      <span class="sqty__feature-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"><path d="M24 10C18 5 10 5 4 8v32c6-3 14-3 20 1 6-4 14-4 20-1V8c-6-3-14-3-20 2Zm0 0v31"/></svg>
      </span>
      <p class="sqty__feature-caption">{{ 'squeeze_thankyou.guidebook_html' | t }}</p>
    </li>
    <li class="sqty__feature">
      <span class="sqty__feature-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4"><circle cx="24" cy="24" r="21"/><path d="m30 18-4 10-10 4 4-10z" fill="currentColor" stroke-linejoin="round"/><circle cx="23" cy="25" r="1.5" fill="#f0e8ff" stroke="none"/></svg>
      </span>
      <p class="sqty__feature-caption">{{ 'squeeze_thankyou.explore_html' | t }}</p>
    </li>
  </ul>
</div>

<script src="{{ 'squeeze-thankyou-lead.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Squeeze Thank You",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "textarea", "id": "hero_title", "label": "Title", "default": "Your Free\nStarter Kit Is Ready." },
    { "type": "textarea", "id": "hero_sub", "label": "Subtitle", "default": "Start with the essentials for your first Korea trip." },
    { "type": "textarea", "id": "hero_note", "label": "Free access note", "default": "Free access. No purchase required." },
    { "type": "text", "id": "cta_label", "label": "CTA button text", "default": "Open My Free Starter Kit" },
    { "type": "url", "id": "cta_url", "label": "CTA button URL" }
  ],
  "presets": [{ "name": "Squeeze Thank You" }]
}
{% endschema %}
