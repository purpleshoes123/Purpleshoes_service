{% comment %}Separate, stable store destinations; QR assets encode these same URLs.{% endcomment %}
<div class="ps-app-downloads" aria-label="Download the Purple Shoes App">
  <a class="ps-app-downloads__store" href="https://apps.apple.com/app/id6759947452" target="_blank" rel="noopener">
    <img src="{{ 'purple-shoes-ios-qr.png' | asset_url }}" alt="Scan to open Purple Shoes in the App Store" width="128" height="128" loading="lazy">
    <span>App Store <span aria-hidden="true">↗</span></span>
    <small>iPhone &amp; iPad</small>
  </a>
  <a class="ps-app-downloads__store" href="https://play.google.com/store/apps/details?id=com.kpurpleshoes.guidekitviewer" target="_blank" rel="noopener">
    <img src="{{ 'purple-shoes-android-qr.png' | asset_url }}" alt="Scan to open Purple Shoes in Google Play" width="128" height="128" loading="lazy">
    <span>Google Play <span aria-hidden="true">↗</span></span>
    <small>Android</small>
  </a>
</div>
{% stylesheet %}
  .ps-app-downloads{display:flex;flex-wrap:wrap;justify-content:center;gap:16px;margin:20px 0}
  .ps-app-downloads__store{display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px;background:#fff;border:1px solid #ded3f7;border-radius:16px;color:#4c1d95;text-decoration:none;box-shadow:0 3px 12px #4c1d9508}
  .ps-app-downloads__store:hover,.ps-app-downloads__store:focus-visible{border-color:#6d28d9;outline:2px solid #6d28d9;outline-offset:2px}
  .ps-app-downloads__store img{display:block;width:128px;height:128px;max-width:100%;border-radius:4px}
  .ps-app-downloads__store>span{font-size:14px;font-weight:700}
  .ps-app-downloads__store small{font-size:12px;color:#6b7280}
{% endstylesheet %}
