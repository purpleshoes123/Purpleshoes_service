// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model WebhookEvent {
  id           String    @id @default(uuid())
  topic        String
  eventKey     String    @unique
  orderId      String?
  payloadJson  String    // JSON string of the raw payload
  payloadHash  String    // SHA256 hash of raw body
  normalizedStatus   String?  // TERMINAL_SUCCESS, TERMINAL_FAIL_RELEASE, TERMINAL_REFUND_RELEASE, NON_TERMINAL
  extractedHoldIds   String?  // JSON array string
  extractedAttemptIds String? // JSON array string
  evaluationError    String?
  releaseResults     String?  // JSON array string (per-hold release result)
  releaseStatus      String?  // SUCCESS/SKIPPED/FAILED/PARTIAL/DRYRUN
  releaseReason      String?  // normalizedStatus or skip reason
  releaseRetryCount  Int      @default(0)
  releaseLastError   String?
  releaseLastAttemptAt DateTime?
  status       String    @default("PENDING") // PENDING, PROCESSED, FAILED
  error        String?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?

  @@index([topic])
  @@index([orderId])
  @@index([eventKey])
  @@index([status])
  @@index([receivedAt])
}

model GuideEntitlementLog {
  id               String   @id @default(cuid())
  shop             String
  topic            String
  customerId       String
  entitlementType  String
  eventType        String
  monthsDelta      Int
  orderId          String?
  refundId         String?
  baseExpiresAt    DateTime?
  previousExpiresAt DateTime?
  newExpiresAt     DateTime?
  status           String
  errorCode        String?
  errorMessage     String?
  rawRef           String?
  createdAt        DateTime @default(now())

  @@index([shop, customerId, createdAt])
  @@index([shop, orderId])
  @@index([shop, refundId])
  @@index([shop, status, createdAt])
}

// A durable, order-scoped outbox. Never automatically retry UNKNOWN delivery.
model PurchaseEmailOutbox {
  id               String    @id
  shopDomain       String    @map("shop_domain")
  orderId          String    @map("order_id")
  kind             String
  entitlementTypes String    @map("entitlement_types")
  status           String    @default("PENDING")
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now()) @map("available_at")
  claimedAt        DateTime? @map("claimed_at")
  claimToken       String?   @map("claim_token")
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([shopDomain, orderId, kind], map: "ux_purchase_email_order_kind")
  @@index([status, availableAt], map: "idx_purchase_email_pending")
  @@map("purchase_email_outbox")
}

model MailTemplate {
  id             String    @id @default(cuid())
  shopDomain     String    @map("shop_domain")
  name           String
  slug           String
  subject        String
  htmlBody       String    @map("html_body")
  textBody       String?   @map("text_body")
  fromName       String?   @map("from_name")
  replyTo        String?   @map("reply_to")
  isActive       Boolean   @default(true) @map("is_active")
  attachmentMode String    @default("NONE") @map("attachment_mode")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([shopDomain, isActive], map: "idx_mail_templates_shop_active")
  @@index([shopDomain, updatedAt], map: "idx_mail_templates_shop_updated")
  @@index([deletedAt], map: "idx_mail_templates_deleted")
  @@map("mail_templates")
}

model MailTemplateAttachment {
  id            String   @id @default(cuid())
  templateId    String   @map("template_id")
  storageType   String   @map("storage_type")
  shopifyFileId String?  @map("shopify_file_id")
  fileUrl       String   @map("file_url")
  fileName      String   @map("file_name")
  mimeType      String   @map("mime_type")
  fileSizeBytes Int      @map("file_size_bytes")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([templateId], map: "idx_mail_template_attachments_template")
  @@index([templateId, sortOrder], map: "idx_mail_template_attachments_template_sort")
  @@map("mail_template_attachments")
}

model MailSendRequest {
  id                String    @id @default(cuid())
  shopDomain        String    @map("shop_domain")
  templateId        String    @map("template_id")
  requestSource     String    @default("STOREFRONT_PAGE") @map("request_source")
  requestKey        String?   @map("request_key")
  recipientEmail    String    @map("recipient_email")
  recipientName     String?   @map("recipient_name")
  recaptchaAction   String?   @map("recaptcha_action")
  recaptchaScore    Float?    @map("recaptcha_score")
  recaptchaSuccess  Boolean?  @map("recaptcha_success")
  status            String    @default("PENDING")
  failureCode       String?   @map("failure_code")
  failureReason     String?   @map("failure_reason")
  emailProvider     String    @default("AWS_SES") @map("email_provider")
  providerMessageId String?   @map("provider_message_id")
  userAgent         String?   @map("user_agent")
  ipHash            String?   @map("ip_hash")
  pagePath          String?   @map("page_path")
  templateNameSnapshot String? @map("template_name_snapshot")
  templateSlugSnapshot String? @map("template_slug_snapshot")
  attachmentModeSnapshot String? @map("attachment_mode_snapshot")
  subjectSnapshot   String?   @map("subject_snapshot")
  htmlBodySnapshot  String?   @map("html_body_snapshot")
  textBodySnapshot  String?   @map("text_body_snapshot")
  fromNameSnapshot  String?   @map("from_name_snapshot")
  replyToSnapshot   String?   @map("reply_to_snapshot")
  createdAt         DateTime  @default(now()) @map("created_at")
  sentAt            DateTime? @map("sent_at")
  metaLeadClaimedAt DateTime? @map("meta_lead_claimed_at")

  @@index([shopDomain, createdAt], map: "idx_mail_send_requests_shop_created")
  @@index([shopDomain, status, createdAt], map: "idx_mail_send_requests_shop_status_created")
  @@index([shopDomain, templateId, createdAt], map: "idx_mail_send_requests_shop_template_created")
  @@index([shopDomain, recipientEmail, createdAt], map: "idx_mail_send_requests_shop_recipient_created")
  @@index([shopDomain, pagePath, createdAt], map: "idx_mail_send_requests_shop_page_created")
  @@index([requestSource], map: "idx_mail_send_requests_source")
  @@index([recaptchaScore], map: "idx_mail_send_requests_recaptcha_score")
  @@map("mail_send_requests")
}

model MailSendRequestAttachment {
  id                    String   @id @default(cuid())
  sendRequestId         String   @map("send_request_id")
  templateAttachmentId  String?  @map("template_attachment_id")
  resolvedFileUrl       String   @map("resolved_file_url")
  resolvedFileName      String   @map("resolved_file_name")
  resolvedMimeType      String   @map("resolved_mime_type")
  resolvedFileSizeBytes Int      @map("resolved_file_size_bytes")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([sendRequestId], map: "idx_mail_send_request_attachments_send_request")
  @@index([templateAttachmentId], map: "idx_mail_send_request_attachments_template_attachment")
  @@map("mail_send_request_attachments")
}

model MailRateLimitCounter {
  id            String   @id @default(cuid())
  shopDomain    String   @map("shop_domain")
  targetType    String   @map("target_type")
  targetKey     String   @map("target_key")
  windowStartAt DateTime @map("window_start_at")
  windowEndAt   DateTime @map("window_end_at")
  requestCount  Int      @default(0) @map("request_count")
  blockedCount  Int      @default(0) @map("blocked_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([shopDomain, targetType, targetKey, windowStartAt], map: "ux_mail_rate_limit_counters_scope_window")
  @@index([shopDomain, targetType, windowEndAt], map: "idx_mail_rate_limit_counters_scope_end")
  @@index([shopDomain, updatedAt], map: "idx_mail_rate_limit_counters_shop_updated")
  @@map("mail_rate_limit_counters")
}

model MailRecipientSuppression {
  id                  String   @id @default(cuid())
  shopDomain          String   @map("shop_domain")
  recipientEmail      String   @map("recipient_email")
  sourceSendRequestId String?  @map("source_send_request_id")
  unsubscribedAt      DateTime @default(now()) @map("unsubscribed_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([shopDomain, recipientEmail], map: "ux_mail_recipient_suppressions_shop_email")
  @@index([shopDomain, unsubscribedAt], map: "idx_mail_recipient_suppressions_shop_unsubscribed")
  @@map("mail_recipient_suppressions")
}

