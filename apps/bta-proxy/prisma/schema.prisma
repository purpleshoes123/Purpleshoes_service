/// A short-lived checkout reservation. Expired rows are intentionally retained
/// for auditability but are excluded from all availability calculations.
// Durable state for the new fleet; populated and verified before traffic cutover.
model BookingMutationJournal {
  sequence BigInt @unique @default(autoincrement())
  id String @id
  shop String
  bookingId String @map("booking_id")
  kind String
  state String
  beforeRecord Json? @db.JsonB @map("before_record")
  afterRecord Json? @db.JsonB @map("after_record")
  lineItemIds Json @default("[]") @db.JsonB @map("line_item_ids")
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([shop, bookingId, sequence(sort: Desc)], map: "booking_mutation_latest")
  @@index([state, createdAt], map: "booking_mutation_pending")
  @@map("booking_mutation_journal")
}

model DurableCouponState {
  stateKey String @id @map("state_key")
  fields Json @db.JsonB
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("durable_coupon_state")
}

model DurableCouponRevocation {
  scope String
  code String

  @@id([scope, code])
  @@map("durable_coupon_revocations")
}

model FleetStateMigration {
  id String @id
  sourceDigest String @map("source_digest")
  details Json @db.JsonB
  verifiedAt DateTime @map("verified_at")

  @@map("fleet_state_migrations")
}

model BookingHold {
  holdId         String   @id @map("hold_id")
  slotKey        String   @map("slot_key")
  poolDayKey     String?  @map("pool_day_key")
  pax            Int
  units          Int      @default(1)
  customerName   String   @map("customer_name")
  customerPhone  String?  @map("customer_phone")
  customerEmail  String?  @map("customer_email")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  idempotencyKey String?  @unique @map("idempotency_key")
  orderDraftKey  String?  @map("order_draft_key")

  @@index([slotKey, expiresAt], map: "idx_booking_holds_slot_expiry")
  @@index([poolDayKey, expiresAt], map: "idx_booking_holds_pool_expiry")
  @@map("booking_holds")
}

/// Durable booking ledger. Redis remains suitable for short-lived locks and
/// caches, while this table is the source of truth for confirmed reservations.
model ConfirmedBooking {
  id                 String   @id @default(cuid())
  shop               String
  orderId            String   @map("order_id")
  lineItemId         String   @map("line_item_id")
  groupKey           String?  @map("group_key")
  slotKey            String   @map("slot_key")
  productId          String   @map("product_id")
  date               String
  bookingMode        String   @map("booking_mode")
  poolKey            String   @map("pool_key")
  guideUnitsRequired Int      @map("guide_units_required")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([shop, orderId, lineItemId], map: "ux_confirmed_bookings_line_item")
  @@unique([shop, orderId, groupKey], map: "ux_confirmed_bookings_group")
  @@index([slotKey], map: "idx_confirmed_bookings_slot")
  @@index([poolKey, date], map: "idx_confirmed_bookings_pool_date")
  @@map("confirmed_bookings")
}
